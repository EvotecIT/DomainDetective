<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`Windows`))' ">
      net472;net8.0;net10.0
    </TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::IsOsPlatform(`OSX`))' Or '$([MSBuild]::IsOsPlatform(`Linux`))' ">
      net8.0;net10.0
    </TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UseLocalHtmlForgeX Condition="'$(UseLocalHtmlForgeX)' == ''">false</UseLocalHtmlForgeX>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DomainDetective\DomainDetective.csproj" />
    <ProjectReference Include="..\DomainDetective.Reports\DomainDetective.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HtmlForgeX\HtmlForgeX\HtmlForgeX.csproj" Condition="'$(UseLocalHtmlForgeX)' == 'true' And Exists('..\..\HtmlForgeX\HtmlForgeX\HtmlForgeX.csproj')" />
    <PackageReference Include="HtmlForgeX" Version="0.43.0" Condition="'$(UseLocalHtmlForgeX)' != 'true' Or !Exists('..\..\HtmlForgeX\HtmlForgeX\HtmlForgeX.csproj')" />
  </ItemGroup>

</Project>
