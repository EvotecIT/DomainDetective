{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/schemas/powerforge.web.pipelinespec.schema.json",
  "cache": true,
  "cachePath": "./_temp/pipeline-cache.json",
  "profile": true,
  "profilePath": "./_temp/pipeline-profile.json",
  "steps": [
    {
      "task": "sources-sync",
      "id": "sync-sources",
      "config": "./site.json",
      "lockMode": "verify",
      "lockPath": "./.powerforge/git-sync-lock.json",
      "writeManifest": true
    },
    {
      "task": "build",
      "id": "build-site",
      "dependsOn": "sync-sources",
      "config": "./site.json",
      "out": "./_site",
      "clean": true
    },
    {
      "task": "verify",
      "id": "verify-site",
      "dependsOn": "build-site",
      "skipModes": ["ci"],
      "config": "./site.json"
    },
    {
      "task": "verify",
      "id": "verify-ci",
      "dependsOn": "build-site",
      "modes": ["ci"],
      "config": "./site.json",
      "baseline": "./.powerforge/verify-baseline.json",
      "failOnNewWarnings": true,
      "failOnNavLint": true,
      "failOnThemeContract": true,
      "warningPreviewCount": 10,
      "errorPreviewCount": 10
    },
    {
      "task": "dotnet-build",
      "id": "build-library",
      "dependsOn": "verify-site",
      "project": "../DomainDetective/DomainDetective.csproj",
      "configuration": "Release",
      "skipIfProjectMissing": true
    },
    {
      "task": "dotnet-build",
      "id": "build-online-host",
      "dependsOn": "build-library",
      "project": "../DomainDetective.OnlineHost/DomainDetective.OnlineHost.csproj",
      "configuration": "Release",
      "skipIfProjectMissing": true
    },
    {
      "task": "dotnet-build",
      "id": "build-powershell",
      "dependsOn": "verify-site",
      "project": "../DomainDetective.PowerShell/DomainDetective.PowerShell.csproj",
      "framework": "net8.0",
      "configuration": "Release",
      "skipIfProjectMissing": true
    },
    {
      "task": "dotnet-build",
      "id": "build-dnsclientx-library",
      "dependsOn": "verify-site",
      "project": "./projects/dnsclientx/DnsClientX/DnsClientX.csproj",
      "framework": "net10.0",
      "configuration": "Release",
      "skipIfProjectMissing": true
    },
    {
      "task": "dotnet-build",
      "id": "build-dnsclientx-powershell",
      "dependsOn": "verify-site",
      "project": "./projects/dnsclientx/DnsClientX.PowerShell/DnsClientX.PowerShell.csproj",
      "framework": "net8.0",
      "configuration": "Release",
      "skipIfProjectMissing": true
    },
    {
      "task": "dotnet-publish",
      "id": "publish-toolbox",
      "dependsOn": "build-library",
      "project": "../DomainDetective.Website/DomainDetective.Website.csproj",
      "out": "../DomainDetective.Website/bin/Release/net10.0/publish",
      "configuration": "Release",
      "extraArgs": "--property:BaseHref=/tools/",
      "skipIfProjectMissing": true
    },
    {
      "task": "apidocs",
      "id": "build-apidocs-csharp",
      "dependsOn": "build-library",
      "config": "./site.json",
      "xml": "../DomainDetective/bin/Release/net10.0/DomainDetective.xml",
      "assembly": "../DomainDetective/bin/Release/net10.0/DomainDetective.dll",
      "out": "./_site/api",
      "title": "DomainDetective API Reference",
      "baseUrl": "/api",
      "format": "both",
      "css": "/css/app.css,/css/api.css",
      "template": "docs",
      "injectCriticalCss": true,
      "nav": "./site.json",
      "navContextPath": "/",
      "sourceRoot": "..",
      "sourceUrl": "https://github.com/EvotecIT/DomainDetective/blob/master/{path}#L{line}",
      "includeNamespace": "DomainDetective",
      "socialAutoGenerate": false,
      "coverageReport": "./_reports/apidocs-coverage.json",
      "failOnCoverage": false,
      "coveragePreviewCount": 10
    },
    {
      "task": "apidocs",
      "id": "build-apidocs-powershell",
      "dependsOn": "build-powershell",
      "config": "./site.json",
      "xml": "../DomainDetective.PowerShell/bin/Release/net8.0/DomainDetective.PowerShell.xml",
      "assembly": "../DomainDetective.PowerShell/bin/Release/net8.0/DomainDetective.PowerShell.dll",
      "out": "./_site/api/powershell",
      "title": "DomainDetective PowerShell API Reference",
      "baseUrl": "/api/powershell",
      "format": "both",
      "css": "/css/app.css,/css/api.css",
      "template": "docs",
      "injectCriticalCss": true,
      "nav": "./site.json",
      "navContextPath": "/",
      "sourceRoot": "..",
      "sourceUrl": "https://github.com/EvotecIT/DomainDetective/blob/master/{path}#L{line}",
      "includeNamespace": "DomainDetective.PowerShell",
      "socialAutoGenerate": false
    },
    {
      "task": "exec",
      "id": "sync-dnsclientx-apidocs",
      "dependsOn": "sync-sources",
      "command": "pwsh",
      "argsList": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "./scripts/Sync-DnsClientXApiDocs.ps1",
        "-SiteRoot",
        "."
      ],
      "workingDirectory": "."
    },
    {
      "task": "apidocs",
      "id": "build-apidocs-dnsclientx-csharp",
      "dependsOn": ["build-dnsclientx-library", "build-site"],
      "config": "./site.json",
      "xml": "./projects/dnsclientx/DnsClientX/bin/Release/net10.0/DnsClientX.xml",
      "assembly": "./projects/dnsclientx/DnsClientX/bin/Release/net10.0/DnsClientX.dll",
      "out": "./_site/api/dnsclientx",
      "title": "DnsClientX API Reference",
      "baseUrl": "/api/dnsclientx",
      "format": "both",
      "css": "/css/app.css,/css/api.css",
      "template": "docs",
      "injectCriticalCss": true,
      "nav": "./site.json",
      "navContextPath": "/",
      "sourceRoot": "./projects/dnsclientx",
      "sourceUrl": "https://github.com/EvotecIT/DnsClientX/blob/master/{path}#L{line}",
      "includeNamespace": "DnsClientX",
      "socialAutoGenerate": false
    },
    {
      "task": "apidocs",
      "id": "build-apidocs-dnsclientx-powershell",
      "dependsOn": ["build-site", "sync-dnsclientx-apidocs", "build-dnsclientx-powershell"],
      "config": "./site.json",
      "type": "PowerShell",
      "helpPath": "./data/apidocs/dnsclientx-powershell/DnsClientX.PowerShell.dll-Help.xml",
      "psManifestPath": "./data/apidocs/dnsclientx-powershell/DnsClientX.psd1",
      "psExamplesPath": "./data/apidocs/dnsclientx-powershell/examples",
      "out": "./_site/api/dnsclientx-powershell",
      "title": "DnsClientX PowerShell Cmdlet Reference",
      "baseUrl": "/api/dnsclientx-powershell",
      "format": "both",
      "template": "docs",
      "bodyClass": "pf-api-docs pf-api-docs--powershell",
      "docsHome": "/products/dnsclientx/",
      "nav": "./site.json",
      "navContextPath": "/",
      "css": "/css/app.css,/css/api.css",
      "injectCriticalCss": true,
      "socialAutoGenerate": false
    },
    {
      "task": "xref-merge",
      "id": "merge-xref",
      "dependsOn": ["build-apidocs-csharp", "build-apidocs-powershell", "build-apidocs-dnsclientx-csharp", "build-apidocs-dnsclientx-powershell"],
      "out": "./data/xrefmap.json",
      "mapFiles": [
        "./_site/api/xrefmap.json",
        "./_site/api/powershell/xrefmap.json",
        "./_site/api/dnsclientx/xrefmap.json",
        "./_site/api/dnsclientx-powershell/xrefmap.json"
      ],
      "preferLast": true,
      "maxReferences": 50000,
      "maxDuplicates": 100,
      "maxReferenceGrowthCount": 50000,
      "maxReferenceGrowthPercent": 300
    },
    {
      "task": "build",
      "id": "build-site-xref-refresh",
      "dependsOn": "merge-xref",
      "config": "./site.json",
      "out": "./_site",
      "clean": false
    },
    {
      "task": "overlay",
      "id": "overlay-toolbox",
      "dependsOn": "publish-toolbox",
      "source": "../DomainDetective.Website/bin/Release/net10.0/publish/wwwroot",
      "destination": "./_site/tools",
      "skipIfSourceMissing": true
    },
    {
      "task": "route-fallbacks",
      "id": "generate-tool-route-fallbacks",
      "dependsOn": "overlay-toolbox",
      "siteRoot": "./_site",
      "template": "../DomainDetective.Website/wwwroot/index.html",
      "items": "./data/tool-route-meta.json",
      "destinationTemplate": "tools/{slug}/index.html",
      "rootOutput": "tools/index.html",
      "rootValues": {
        "__DD_PAGE_TITLE__": "Domain Detective Browser Tools",
        "__DD_META_DESCRIPTION__": "Browse DomainDetective browser tools for DNS, email, TLS, web security, and threat intelligence checks.",
        "__DD_CANONICAL_URL__": "https://domaindetective.dev/tools/",
        "__DD_OG_TITLE__": "Domain Detective Browser Tools",
        "__DD_OG_DESCRIPTION__": "Browse DomainDetective browser tools for DNS, email, TLS, web security, and threat intelligence checks.",
        "__DD_LOADING_TITLE__": "Preparing browser tools",
        "__DD_LOADING_TEXT__": "Loading the shared navigation, theme, and DNS analysis toolkit."
      },
      "replacements": {
        "__DD_PAGE_TITLE__": "{name} | Domain Detective Tools",
        "__DD_META_DESCRIPTION__": "{description}",
        "__DD_CANONICAL_URL__": "https://domaindetective.dev/tools/{slug}/",
        "__DD_OG_TITLE__": "{name} | Domain Detective Tools",
        "__DD_OG_DESCRIPTION__": "{description}",
        "__DD_LOADING_TITLE__": "Preparing {name}",
        "__DD_LOADING_TEXT__": "Loading the {name} workspace."
      },
      "reportPath": "./_reports/tool-route-fallbacks.json"
    },
    {
      "task": "verify",
      "id": "verify-ci-final",
      "dependsOn": "generate-tool-route-fallbacks",
      "modes": ["ci"],
      "config": "./site.json",
      "baseline": "./.powerforge/verify-baseline.json",
      "failOnNewWarnings": true,
      "failOnNavLint": true,
      "failOnThemeContract": true,
      "warningPreviewCount": 10,
      "errorPreviewCount": 10
    },
    {
      "task": "llms",
      "id": "build-llms",
      "dependsOn": "verify-ci-final",
      "siteRoot": "./_site",
      "apiIndex": "./_site/api/index.json",
      "apiBase": "/api",
      "name": "DomainDetective",
      "package": "DomainDetective",
      "overview": "DomainDetective is a comprehensive domain analysis toolkit supporting 115+ protocols for DNS, email security, TLS, web security, and threat intelligence analysis.",
      "license": "MIT",
      "targets": ".NET 8+, .NET 10+, PowerShell 5.1+",
      "quickstart": "./llms-quickstart.txt"
    },
    {
      "task": "sitemap",
      "id": "build-sitemap",
      "dependsOn": "build-llms",
      "siteRoot": "./_site",
      "baseUrl": "https://domaindetective.dev",
      "apiSitemap": "./_site/api/sitemap.xml",
      "entriesJson": "./data/sitemap.entries.json",
      "includeNoIndexHtml": false,
      "noDefaultExclude": false,
      "excludePatterns": ["**/api-fragments/**", "**/*.scripts.html", "**/*.head.html"],
      "includeGeneratedHtmlRouteInXml": false,
      "json": true,
      "jsonOut": "./_site/sitemap/index.json",
      "html": true,
      "htmlOutput": "./_site/sitemap/index.html",
      "htmlTitle": "DomainDetective Sitemap"
    },
    {
      "task": "indexnow",
      "id": "submit-indexnow",
      "dependsOn": "build-sitemap",
      "modes": ["ci"],
      "baseUrl": "https://domaindetective.dev",
      "siteRoot": "./_site",
      "scopeFromBuildUpdated": true,
      "keyEnv": "INDEXNOW_KEY",
      "optionalKey": true,
      "continueOnError": true,
      "reportPath": "./_reports/indexnow.json",
      "summaryPath": "./_reports/indexnow.md"
    },
    {
      "task": "optimize",
      "id": "optimize-site",
      "dependsOn": "submit-indexnow",
      "skipModes": ["dev"],
      "siteRoot": "./_site",
      "config": "./site.json",
      "criticalCss": "./themes/domaindetective/critical.css",
      "minifyHtml": true,
      "minifyCss": true,
      "minifyJs": true,
      "optimizeImages": true,
      "imageExtensions": [".png", ".jpg", ".jpeg", ".webp"],
      "imageQuality": 82,
      "imageStripMetadata": true,
      "imageGenerateWebp": true,
      "imagePreferNextGen": true,
      "imageWidths": [480, 960, 1440],
      "imageEnhanceTags": true,
      "imageMaxTotalBytes": 70000000,
      "cacheHeaders": true,
      "cacheHeadersOut": "_headers",
      "reportPath": "./_reports/optimize-report.json"
    },
    {
      "task": "doctor",
      "id": "doctor-site",
      "dependsOn": "optimize-site",
      "skipModes": ["dev"],
      "config": "./site.json",
      "siteRoot": "./_site",
      "noBuild": true,
      "noVerify": true,
      "baseline": "./.powerforge/audit-baseline.json",
      "failOnNewIssues": true,
      "maxTotalFiles": 30000,
      "exclude": "**/*.scripts.html,**/*.head.html,**/api-fragments/**,api-fragments/**,api/**",
      "ignoreNav": "sitemap/**,search/**,tools/**",
      "noDefaultIgnoreNav": true,
      "navSelector": "header nav.dd-nav",
      "navCanonicalPath": "index.html",
      "navCanonicalSelector": "header nav.dd-nav",
      "navCanonicalRequired": true,
      "navRequiredLinks": "/,/docs/,/tools/",
      "minNavCoveragePercent": 35,
      "failOnCategories": "budget,nav,link,asset,rendered-console-error,rendered-request-failure",
      "rendered": false,
      "renderedEnsureInstalled": false,
      "renderedMaxPages": 10,
      "renderedInclude": "index.html,docs/**,faq/**,downloads/**",
      "renderedExclude": "api/**,tools/**",
      "summary": true,
      "summaryPath": "./_reports/doctor-summary.json",
      "summaryMaxIssues": 50,
      "checkUtf8": true,
      "checkMetaCharset": true,
      "checkUnicodeReplacementChars": true,
      "requiredRoutes": "/,/docs/,/tools/,/404.html,/search/,/sitemap/,/products/dnsclientx/,/docs/dnsclientx/"
    }
  ]
}
