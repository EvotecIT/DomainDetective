{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/schemas/powerforge.web.themespec.schema.json",
  "schemaVersion": 2,
  "contractVersion": 2,
  "name": "domaindetective",
  "engine": "scriban",
  "layoutsPath": "layouts",
  "partialsPath": "partials",
  "scriptsPath": "scripts",
  "defaultLayout": "home",
  "features": ["docs", "apiDocs", "blog", "search", "notFound"],
  "slots": {
    "header": "header",
    "footer": "footer",
    "api-header": "api-header",
    "api-footer": "api-footer",
    "sidebar": "sidebar",
    "toc": "toc",
    "theme-tokens": "theme-tokens"
  },
  "featureContracts": {
    "apiDocs": {
      "requiredPartials": ["api-header", "api-footer"],
      "cssHrefs": ["/css/app.css", "/css/api.css"],
      "requiredCssSelectors": [
        ".api-layout",
        ".api-sidebar",
        ".api-content"
      ]
    },
    "docs": {
      "requiredLayouts": ["docs"],
      "requiredPartials": ["header", "footer", "sidebar", "toc", "theme-tokens"]
    },
    "blog": {
      "requiredLayouts": ["page"],
      "requiredPartials": ["header", "footer", "theme-tokens"]
    },
    "notFound": {
      "requiredSurfaces": ["notFound"]
    }
  },
  "tokens": {
    "color": {
      "bg": "#060B18",
      "bgAlt": "#0D1326",
      "panel": "#0D1326",
      "card": "#111833",
      "ink": "#e2e8f0",
      "inkStrong": "#FFFFFF",
      "muted": "#94a3b8",
      "accent": "#00D9FF",
      "accentLight": "#33E1FF",
      "accentDark": "#00A8C6",
      "accent2": "#8B5CF6",
      "border": "#1a2744",
      "success": "#22c55e",
      "warning": "#f59e0b",
      "danger": "#ef4444",
      "headerBg": "rgba(6, 11, 24, 0.88)",
      "cardBg": "rgba(17, 24, 51, 0.6)",
      "codeBg": "#080D1C",
      "codeBorder": "rgba(26, 39, 68, 0.8)",
      "glowPrimary": "rgba(0, 217, 255, 0.15)",
      "glowSecondary": "rgba(139, 92, 246, 0.12)",
      "buttonPrimaryBg": "#00D9FF",
      "buttonPrimaryText": "#060B18",
      "buttonSecondaryBg": "rgba(139, 92, 246, 0.2)",
      "buttonSecondaryBorder": "rgba(139, 92, 246, 0.5)",
      "buttonGhostBorder": "rgba(148, 163, 184, 0.4)"
    },
    "radius": {
      "base": "12px",
      "sm": "8px",
      "lg": "16px"
    },
    "shadow": {
      "button": "0 8px 24px rgba(0, 217, 255, 0.15)",
      "panel": "0 24px 48px rgba(2, 4, 15, 0.5)",
      "card": "0 12px 28px rgba(2, 4, 15, 0.4)"
    },
    "layout": {
      "maxWidth": "1200px"
    },
    "font": {
      "body": "Inter, system-ui, sans-serif",
      "display": "Space Grotesk, Inter, sans-serif",
      "mono": "JetBrains Mono, Consolas, monospace"
    }
  }
}
