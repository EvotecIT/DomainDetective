{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/schemas/powerforge.web.sitespec.schema.json",
  "SchemaVersion": 1,
  "Name": "DomainDetective",
  "BaseUrl": "https://domaindetective.dev",
  "DefaultTheme": "domaindetective",
  "Features": ["docs", "apiDocs", "search", "notFound"],
  "TrailingSlash": "always",
  "ContentRoot": "content",
  "ThemesRoot": "themes",
  "DataRoot": "data",
  "StaticAssets": [
    { "Source": "static" }
  ],
  "Collections": [
    {
      "Name": "pages",
      "Input": "content/pages",
      "Output": "/",
      "DefaultLayout": "home",
      "UseToc": false,
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "docs",
      "Input": "content/docs",
      "Output": "/docs",
      "DefaultLayout": "docs",
      "UseToc": true,
      "TocFile": "content/docs/toc.json",
      "Include": ["*.md", "**/*.md"]
    }
  ],
  "Head": {
    "Links": [
      { "Rel": "icon", "Href": "/favicon.svg", "Type": "image/svg+xml" },
      { "Rel": "preconnect", "Href": "https://fonts.googleapis.com" },
      { "Rel": "preconnect", "Href": "https://fonts.gstatic.com", "Crossorigin": "anonymous" },
      { "Rel": "dns-prefetch", "Href": "https://cdn.jsdelivr.net" },
      { "Rel": "preconnect", "Href": "https://cdn.jsdelivr.net", "Crossorigin": "anonymous" },
      { "Rel": "stylesheet", "Href": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" }
    ]
  },
  "Social": {
    "Enabled": true,
    "SiteName": "DomainDetective",
    "Image": "/favicon.svg",
    "TwitterCard": "summary_large_image",
    "AutoGenerateCards": true,
    "GeneratedCardsPath": "/assets/social/generated",
    "GeneratedCardWidth": 1200,
    "GeneratedCardHeight": 630,
    "GeneratedCardStyle": "default",
    "GeneratedCardVariant": "standard",
    "GeneratedCardStylesByCollection": {
      "pages": "default",
      "docs": "docs"
    },
    "GeneratedCardVariantsByCollection": {
      "pages": "hero",
      "docs": "compact"
    }
  },
  "StructuredData": {
    "Enabled": true,
    "Breadcrumbs": true
  },
  "EditLinks": {
    "Enabled": true,
    "Template": "https://github.com/EvotecIT/DomainDetective/edit/master/{path}",
    "PathBase": "Website"
  },
  "AssetRegistry": {
    "CssStrategy": "blocking",
    "Bundles": [
      { "Name": "global", "Css": ["/css/app.css"], "Js": ["/js/site.js"] },
      { "Name": "docs", "Css": ["/css/app.css", "/css/docs.css"], "Js": ["/js/site.js"] },
      { "Name": "api", "Css": ["/css/app.css", "/css/api.css"], "Js": ["/js/site.js"] }
    ],
    "RouteBundles": [
      { "Match": "/api/**", "Bundles": ["api"] },
      { "Match": "/docs/**", "Bundles": ["docs"] },
      { "Match": "/**", "Bundles": ["global"] }
    ],
    "CriticalCss": [
      { "Name": "domaindetective", "Path": "themes/domaindetective/critical.css" }
    ]
  },
  "AssetPolicy": {
    "Mode": "local",
    "Hashing": {
      "Enabled": false,
      "Extensions": [".css", ".js"]
    },
    "CacheHeaders": {
      "Enabled": true,
      "OutputPath": "_headers"
    }
  },
  "Prism": {
    "DefaultLanguage": "csharp",
    "ThemeLight": "/css/prism-theme.css",
    "ThemeDark": "/css/prism-theme.css"
  },
  "A11y": {
    "SkipLinkLabel": "Skip to content",
    "ExternalLinkLabel": "Opens in a new tab",
    "NavToggleLabel": "Toggle navigation",
    "SearchLabel": "Search"
  },
  "LinkRules": {
    "ExternalRel": "noopener",
    "ExternalTarget": "_blank",
    "AddExternalIcon": true
  },
  "Navigation": {
    "Surfaces": [
      { "Name": "main", "Path": "/", "PrimaryMenu": "main" },
      { "Name": "docs", "Path": "/docs/", "Collection": "docs", "Layout": "docs", "PrimaryMenu": "main" },
      { "Name": "apidocs", "Path": "/api/", "Layout": "apiDocs", "PrimaryMenu": "main" },
      { "Name": "notFound", "Path": "/404/", "PrimaryMenu": "main" }
    ],
    "Menus": [
      {
        "Name": "main",
        "Items": [
          { "Title": "Home", "Url": "/" },
          { "Title": "Tools", "Url": "/tools/" },
          { "Title": "API", "Url": "/api/" },
          { "Title": "Docs", "Url": "/docs/" },
          { "Title": "Downloads", "Url": "/downloads/" }
        ]
      },
      {
        "Name": "footer-tools",
        "Items": [
          { "Title": "SPF Lookup", "Url": "/tools/spf/" },
          { "Title": "DKIM Lookup", "Url": "/tools/dkim/" },
          { "Title": "DMARC Lookup", "Url": "/tools/dmarc/" },
          { "Title": "DNS Lookup", "Url": "/tools/dns-lookup/" },
          { "Title": "All Tools", "Url": "/tools/" }
        ]
      },
      {
        "Name": "footer-resources",
        "Items": [
          { "Title": "Quick Start", "Url": "/docs/quickstart/" },
          { "Title": "C# API", "Url": "/docs/csharp-api/" },
          { "Title": "PowerShell", "Url": "/docs/powershell-cmdlets/" },
          { "Title": "CLI Usage", "Url": "/docs/cli-usage/" },
          { "Title": "FAQ", "Url": "/faq/" },
          { "Title": "GitHub", "Url": "https://github.com/EvotecIT/DomainDetective", "External": true }
        ]
      },
      {
        "Name": "footer-company",
        "Items": [
          { "Title": "Evotec Services", "Url": "https://evotec.xyz", "External": true },
          { "Title": "Blog", "Url": "https://evotec.xyz/hub", "External": true },
          { "Title": "Privacy Policy", "Url": "/privacy/" },
          { "Title": "Changelog", "Url": "/changelog/" }
        ]
      }
    ],
    "Actions": [
      {
        "Title": "Toggle theme",
        "AriaLabel": "Toggle theme",
        "Kind": "button",
        "CssClass": "nav-icon theme-cycle-btn",
        "IconHtml": "<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true' focusable='false'><circle cx='12' cy='12' r='5'/><path d='M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42'/></svg>"
      },
      {
        "Title": "GitHub",
        "AriaLabel": "GitHub",
        "Url": "https://github.com/EvotecIT/DomainDetective",
        "External": true,
        "CssClass": "nav-icon",
        "IconHtml": "<svg viewBox='0 0 24 24' fill='currentColor' aria-hidden='true' focusable='false'><path d='M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z'/></svg>"
      },
      {
        "Title": "Try Online",
        "AriaLabel": "Try Domain Detective Online",
        "Url": "/tools/",
        "CssClass": "nav-cta",
        "IconHtml": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' class='nav-cta-icon' aria-hidden='true' focusable='false'><circle cx='11' cy='11' r='8'/><path d='m21 21-4.35-4.35'/></svg>",
        "Text": "Try Online"
      }
    ]
  }
}
