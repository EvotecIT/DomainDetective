{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/schemas/powerforge.web.sitespec.schema.json",
  "SchemaVersion": 1,
  "Name": "DomainDetective",
  "BaseUrl": "https://domaindetective.dev",
  "DefaultTheme": "domaindetective",
  "Features": ["docs", "apiDocs", "blog", "search", "notFound"],
  "TrailingSlash": "always",
  "ContentRoot": "content",
  "ProjectsRoot": "projects",
  "ThemesRoot": "themes",
  "DataRoot": "data",
  "Sources": [
    {
      "Repo": "EvotecIT/DnsClientX",
      "Slug": "dnsclientx",
      "Destination": "./projects/dnsclientx"
    }
  ],
  "StaticAssets": [
    { "Source": "static" }
  ],
  "Collections": [
    {
      "Name": "pages",
      "Input": "content/pages",
      "Output": "/",
      "DefaultLayout": "home",
      "UseToc": false,
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "products",
      "Input": "content/products",
      "Output": "/products",
      "DefaultLayout": "page",
      "UseToc": false,
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "docs",
      "Input": "content/docs",
      "Output": "/docs",
      "DefaultLayout": "docs",
      "UseToc": true,
      "TocFile": "content/docs/toc.json",
      "Include": ["*.md", "**/*.md"]
    },
    {
      "Name": "blog",
      "Input": "content/blog",
      "Output": "/blog",
      "DefaultLayout": "page",
      "UseToc": false,
      "Include": ["*.md", "**/*.md"],
      "Preset": "blog",
      "EditorialCardClass": "dd-editorial-card",
      "EditorialListClass": "dd-editorial-list",
      "EditorialCardImageAspect": "16/9",
      "EditorialCardImageFit": "cover"
    }
  ],
  "Taxonomies": [
    {
      "Name": "tags",
      "BasePath": "/tags",
      "ListLayout": "page",
      "TermLayout": "page"
    },
    {
      "Name": "categories",
      "BasePath": "/categories",
      "ListLayout": "page",
      "TermLayout": "page"
    }
  ],
  "Head": {
    "Links": [
      { "Rel": "icon", "Href": "/favicon.svg", "Type": "image/svg+xml" },
      { "Rel": "preload", "Href": "/fonts/bricolage-grotesque-latin.woff2", "As": "font", "Type": "font/woff2", "Crossorigin": "anonymous" },
      { "Rel": "preload", "Href": "/fonts/inter-latin.woff2", "As": "font", "Type": "font/woff2", "Crossorigin": "anonymous" }
    ],
    "Meta": [
      { "Name": "theme-color", "Content": "#07090d" }
    ]
  },
  "Social": {
    "Enabled": true,
    "SiteName": "DomainDetective",
    "Image": "/favicon.svg",
    "TwitterCard": "summary_large_image",
    "AutoGenerateCards": true,
    "GeneratedCardsPath": "/assets/social/generated",
    "GeneratedCardWidth": 1200,
    "GeneratedCardHeight": 630,
    "GeneratedCardStyle": "default",
    "GeneratedCardVariant": "standard",
    "GeneratedCardStylesByCollection": {
      "pages": "default",
      "docs": "docs",
      "blog": "editorial"
    },
    "GeneratedCardVariantsByCollection": {
      "pages": "hero",
      "docs": "compact",
      "blog": "compact"
    }
  },
  "StructuredData": {
    "Enabled": true,
    "Breadcrumbs": true,
    "WebPage": true,
    "SoftwareSourceCode": true,
    "OrganizationName": "Evotec",
    "OrganizationUrl": "https://evotec.xyz/",
    "OrganizationLogo": "https://evotec.xyz/favicon.svg",
    "OrganizationSameAs": ["https://github.com/EvotecIT"]
  },
  "Seo": {
    "CrawlPolicy": {
      "Enabled": true,
      "DefaultRobots": "index,follow"
    }
  },
  "AgentReadiness": {
    "Enabled": true,
    "HeadersPath": "_headers",
    "LinkHeaders": true,
    "Robots": true,
    "SecurityHeaders": {
      "Enabled": true,
      "Hsts": false,
      "ContentSecurityPolicyValue": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://dns.google https://cloudflare-dns.com https://stat.ripe.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    },
    "ContentSignals": {
      "Enabled": true,
      "Search": true,
      "AiInput": true,
      "AiTrain": false
    },
    "BotRules": [
      { "UserAgent": "GPTBot", "Disallow": "/" },
      { "UserAgent": "ChatGPT-User", "Allow": "/" },
      { "UserAgent": "OAI-SearchBot", "Allow": "/" },
      { "UserAgent": "ClaudeBot", "Disallow": "/" },
      { "UserAgent": "Claude-SearchBot", "Allow": "/" },
      { "UserAgent": "Claude-User", "Allow": "/" },
      { "UserAgent": "PerplexityBot", "Allow": "/" },
      { "UserAgent": "Perplexity-User", "Allow": "/" },
      { "UserAgent": "Google-Extended", "Disallow": "/" },
      { "UserAgent": "Applebot-Extended", "Disallow": "/" },
      { "UserAgent": "Meta-ExternalAgent", "Disallow": "/" },
      { "UserAgent": "Amazonbot", "Disallow": "/" },
      { "UserAgent": "CCBot", "Disallow": "/" }
    ],
    "ApiCatalog": {
      "Enabled": true,
      "Entries": [
        { "Anchor": "/api/", "ServiceDesc": "/api/index.json", "ServiceDoc": "/api/", "Title": "DomainDetective API Reference" },
        { "Anchor": "/api/powershell/", "ServiceDesc": "/api/powershell/index.json", "ServiceDoc": "/api/powershell/", "Title": "DomainDetective PowerShell Cmdlet Reference" },
        { "Anchor": "/api/dnsclientx/", "ServiceDesc": "/api/dnsclientx/index.json", "ServiceDoc": "/api/dnsclientx/", "Title": "DnsClientX API Reference" },
        { "Anchor": "/api/dnsclientx-powershell/", "ServiceDesc": "/api/dnsclientx-powershell/index.json", "ServiceDoc": "/api/dnsclientx-powershell/", "Title": "DnsClientX PowerShell Cmdlet Reference" }
      ]
    },
    "AgentSkills": {
      "Enabled": true,
      "Skills": [
        {
          "Name": "domaindetective-site-assistant",
          "Type": "skill-md",
          "Description": "Use DomainDetective documentation, API references, DNS tools, sitemap, and llms files.",
          "Content": "---\nname: domaindetective-site-assistant\ndescription: Use DomainDetective documentation, API references, DNS tools, sitemap, and llms resources.\n---\n\n# DomainDetective Site Assistant\n\nUse this skill when answering questions about DomainDetective and DnsClientX.\n\n- Prefer canonical pages from https://domaindetective.dev.\n- Use `/docs/` for product and workflow guidance.\n- Use `/api/` routes for DomainDetective API references and `/api/dnsclientx/` routes for DnsClientX API references.\n- Check `/llms.txt`, `/llms.json`, and `/llms-full.txt` when present for agent-readable summaries.\n- Check `/.well-known/api-catalog` before assuming API documentation paths.\n- Respect `/robots.txt` and Content-Signal preferences.\n"
        }
      ]
    },
    "AgentsJson": {
      "Enabled": true,
      "Description": "Agent-facing discovery metadata for DomainDetective documentation, DNS tools, API references, and support resources."
    },
    "A2AAgentCard": { "Enabled": false },
    "McpServerCard": { "Enabled": false },
    "OpenApi": { "Enabled": false },
    "WebMcp": true,
    "WebMcpTools": [
      {
        "Name": "query_dns_records",
        "Route": "/tools/raw-dns-query/",
        "Description": "Resolve one bounded public DNS record query and leave the result visible in the DomainDetective playground.",
        "Kind": "page-tool",
        "ReadOnly": true
      }
    ],
    "MarkdownNegotiation": false,
    "MarkdownArtifacts": { "Enabled": true, "MaxPages": 0 }
  },
  "Cloudflare": {
    "Cache": {
      "EdgeTtlSeconds": 604800
    },
    "PurgeMode": "incremental",
    "SmartTieredCache": true
  },
  "EditLinks": {
    "Enabled": true,
    "Template": "https://github.com/EvotecIT/DomainDetective/edit/master/{path}",
    "PathBase": "Website"
  },
  "AssetRegistry": {
    "CssStrategy": "blocking",
    "Bundles": [
      { "Name": "global", "Css": ["/css/app.css", "/css/pages.css", "/css/prism-theme.css"], "Js": ["/js/site.js"] },
      { "Name": "home", "Css": ["/css/home.css"], "Js": ["/js/quickscan.js"] },
      { "Name": "docs", "Css": ["/css/docs.css"] },
      { "Name": "api", "Css": ["/css/api.css"] },
      { "Name": "tools", "Css": ["/css/tools.css"], "Js": ["/js/quickscan.js", "/js/tools.js"] }
    ],
    "RouteBundles": [
      { "Match": "/**", "Bundles": ["global"] },
      { "Match": "/", "Bundles": ["home"] },
      { "Match": "/docs/**", "Bundles": ["docs"] },
      { "Match": "/api/**", "Bundles": ["api"] },
      { "Match": "/tools/**", "Bundles": ["tools"] }
    ],
    "CriticalCss": [
      { "Name": "domaindetective", "Path": "themes/domaindetective/critical.css" }
    ]
  },
  "AssetPolicy": {
    "Mode": "local",
    "Hashing": {
      "Enabled": false,
      "Extensions": [".css", ".js"]
    },
    "CacheHeaders": {
      "Enabled": true,
      "OutputPath": "_headers"
    }
  },
  "Prism": {
    "Mode": "auto",
    "Source": "local",
    "DefaultLanguage": "csharp",
    "ThemeLight": "/css/prism-theme.css",
    "ThemeDark": "/css/prism-theme.css",
    "Local": {
      "Core": "/assets/prism/prism-core.min.js",
      "Autoloader": "/assets/prism/prism-autoloader.min.js",
      "LanguagesPath": "/assets/prism/components/"
    }
  },
  "A11y": {
    "SkipLinkLabel": "Skip to content",
    "ExternalLinkLabel": "Opens in a new tab",
    "NavToggleLabel": "Toggle navigation",
    "SearchLabel": "Search"
  },
  "LinkRules": {
    "ExternalRel": "noopener",
    "ExternalTarget": "_blank",
    "AddExternalIcon": true
  },
  "Navigation": {
    "Surfaces": [
      { "Name": "main", "Path": "/", "PrimaryMenu": "main" },
      { "Name": "products", "Path": "/products/", "PrimaryMenu": "main" },
      { "Name": "docs", "Path": "/docs/", "Collection": "docs", "Layout": "docs", "PrimaryMenu": "main", "SidebarMenu": "docs" },
      { "Name": "apidocs", "Path": "/api/", "Layout": "apiDocs", "PrimaryMenu": "main" },
      { "Name": "notFound", "Path": "/404/", "PrimaryMenu": "main" }
    ],
    "Menus": [
      {
        "Name": "main",
        "Items": [
          {
            "Id": "tools",
            "Title": "Tools",
            "Url": "/tools/",
            "Description": "Run DomainDetective checks against any domain, right in your browser.",
            "Meta": { "wide": true, "foot_text": "27 browser tools, no sign-up and nothing stored.", "foot_link": "Browse every tool" },
            "Items": [
              { "Title": "Domain overview", "Url": "/tools/domain-overview/", "Description": "Every signal for a domain in one report." },
              { "Title": "Email authentication", "Url": "/tools/#email-security", "Description": "SPF, DKIM, DMARC, MX, MTA-STS, TLS-RPT and BIMI." },
              { "Title": "DNS and DNSSEC", "Url": "/tools/#dns", "Description": "Records, delegation, propagation and chain of trust." },
              { "Title": "TLS and certificates", "Url": "/tools/#tls-cert", "Description": "Certificates, CAA and DANE." },
              { "Title": "Web security", "Url": "/tools/#web-security", "Description": "Security headers and security.txt." },
              { "Title": "Reputation", "Url": "/tools/#threat-intel", "Description": "Blocklists and dangling CNAME takeovers." },
              { "Title": "Registration", "Url": "/tools/rdap/", "Description": "RDAP and WHOIS for owners and expiry." },
              { "Title": "Discovery", "Url": "/tools/#web-discovery", "Description": "Sitemaps, AI agent readiness and CT subdomains." },
              { "Title": "Raw DNS query", "Url": "/tools/raw-dns-query/", "Description": "Ask any resolver for any record type." }
            ]
          },
          {
            "Id": "developers",
            "Title": "Developers",
            "Url": "/docs/",
            "Description": "Automate the same checks from PowerShell, .NET or your pipeline.",
            "Items": [
              { "Title": "Quick start", "Url": "/docs/quickstart/", "Description": "Install and run your first checks." },
              { "Title": "PowerShell module", "Url": "/docs/powershell-cmdlets/", "Description": "Test-DD* cmdlets for scripts and reports." },
              { "Title": ".NET library", "Url": "/docs/csharp-api/", "Description": "Embed DomainHealthCheck in your services." },
              { "Title": "CLI", "Url": "/docs/cli-usage/", "Description": "Scan domains from a shell or CI job." },
              { "Title": "API reference", "Url": "/api/", "Description": "Every public type and member." },
              { "Title": "DnsClientX", "Url": "/products/dnsclientx/", "Description": "The DNS client underneath DomainDetective." }
            ]
          },
          { "Title": "Blog", "Url": "/blog/" },
          { "Title": "Downloads", "Url": "/downloads/" }
        ]
      },
      {
        "Name": "footer-tools",
        "Items": [
          { "Title": "Domain overview", "Url": "/tools/domain-overview/" },
          { "Title": "SPF lookup", "Url": "/tools/spf/" },
          { "Title": "DMARC lookup", "Url": "/tools/dmarc/" },
          { "Title": "DKIM lookup", "Url": "/tools/dkim/" },
          { "Title": "DNS lookup", "Url": "/tools/dns-lookup/" },
          { "Title": "Certificate check", "Url": "/tools/cert-check/" },
          { "Title": "All tools", "Url": "/tools/" }
        ]
      },
      {
        "Name": "footer-developers",
        "Items": [
          { "Title": "Quick start", "Url": "/docs/quickstart/" },
          { "Title": "Documentation", "Url": "/docs/" },
          { "Title": "PowerShell reference", "Url": "/api/powershell/" },
          { "Title": ".NET API reference", "Url": "/api/" },
          { "Title": "DnsClientX", "Url": "/products/dnsclientx/" },
          { "Title": "Downloads", "Url": "/downloads/" },
          { "Title": "Changelog", "Url": "/changelog/" }
        ]
      },
      {
        "Name": "footer-community",
        "Items": [
          { "Title": "Star on GitHub", "Url": "https://github.com/EvotecIT/DomainDetective", "External": true },
          { "Title": "Join Discord", "Url": "https://evo.yt/discord", "External": true },
          { "Title": "Report an issue", "Url": "https://github.com/EvotecIT/DomainDetective/issues", "External": true },
          { "Title": "Blog", "Url": "/blog/" },
          { "Title": "FAQ", "Url": "/faq/" }
        ]
      },
      {
        "Name": "footer-company",
        "Items": [
          { "Title": "Evotec", "Url": "https://evotec.xyz/", "External": true },
          { "Title": "All products", "Url": "https://evotec.xyz/products/", "External": true },
          { "Title": "Privacy", "Url": "/privacy/" }
        ]
      }
    ],
    "Auto": [
      { "Collection": "docs", "Menu": "docs", "Root": "/docs", "IncludeIndex": true, "MaxDepth": 3, "Sort": "weight" }
    ],
    "Actions": [
      {
        "Title": "Toggle theme",
        "AriaLabel": "Switch between light and dark theme",
        "Kind": "button",
        "CssClass": "nav-icon theme-cycle-btn",
        "IconHtml": "<svg class='dd-theme-sun' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true' focusable='false'><circle cx='12' cy='12' r='4.2'/><path d='M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6'/></svg><svg class='dd-theme-moon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linejoin='round' aria-hidden='true' focusable='false'><path d='M20 14.6A8 8 0 0 1 9.4 4a8 8 0 1 0 10.6 10.6Z'/></svg>"
      },
      {
        "Title": "Join the Evotec Discord",
        "AriaLabel": "Join the Evotec Discord",
        "Url": "https://evo.yt/discord",
        "External": true,
        "CssClass": "nav-icon",
        "IconHtml": "<svg viewBox='0 0 24 24' fill='currentColor' aria-hidden='true' focusable='false'><path d='M20.32 4.37A19.8 19.8 0 0 0 15.4 2.8a13.6 13.6 0 0 0-.63 1.3 18.4 18.4 0 0 0-5.53 0 13 13 0 0 0-.64-1.3 19.7 19.7 0 0 0-4.92 1.53C.56 9.04-.29 13.6.13 18.1a19.9 19.9 0 0 0 6.03 3.05c.49-.67.92-1.38 1.3-2.12a12.9 12.9 0 0 1-2.04-.98l.5-.39a14.2 14.2 0 0 0 12.17 0l.5.39c-.65.39-1.33.71-2.04.98.37.74.81 1.45 1.3 2.12a19.8 19.8 0 0 0 6.03-3.05c.5-5.2-.85-9.72-3.56-13.73ZM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42s.95-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Zm7.96 0c-1.18 0-2.16-1.09-2.16-2.42s.95-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Z'/></svg>"
      },
      {
        "Title": "DomainDetective on GitHub",
        "AriaLabel": "DomainDetective on GitHub",
        "Url": "https://github.com/EvotecIT/DomainDetective",
        "External": true,
        "CssClass": "nav-icon",
        "IconHtml": "<svg viewBox='0 0 24 24' fill='currentColor' aria-hidden='true' focusable='false'><path d='M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.27 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z'/></svg>"
      },
      {
        "Title": "Install DomainDetective",
        "AriaLabel": "Install DomainDetective",
        "Url": "/downloads/",
        "CssClass": "nav-cta",
        "IconHtml": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='nav-cta-icon' aria-hidden='true' focusable='false'><path d='M12 3v12'/><path d='m7 10 5 5 5-5'/><path d='M5 21h14'/></svg>",
        "Text": "Install"
      }
    ]
  }
}
