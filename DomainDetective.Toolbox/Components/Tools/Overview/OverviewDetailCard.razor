@if (Card is not null) {
    <div class="@($"{ContainerClass} overview-detail-card")">
        <span class="tool-summary-label">@Card.Title</span>
        <strong class="tool-summary-value">@Card.ValueLabel</strong>
        <p class="tool-summary-note">@Card.Summary</p>
        @if (Card.Tags.Count > 0) {
            <div class="tool-chip-list">
                @foreach (var tag in Card.Tags) {
                    <span class="tool-chip">@tag</span>
                }
            </div>
        }
        @if (Card.Samples.Count > 0) {
            <ul class="tool-bullet-list mt-2">
                @foreach (var sample in Card.Samples) {
                    <li>@sample</li>
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter] public required DomainOverviewDetailCardView Card { get; set; }
    [Parameter] public string ContainerClass { get; set; } = "tool-summary-card";
}
