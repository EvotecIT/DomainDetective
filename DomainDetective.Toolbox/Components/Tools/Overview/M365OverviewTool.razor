@using System.Linq
@using DomainDetective.Views
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

@{
    var tenant = Info?.Tenant;
    var allChecks = Info?.MailDnsChecks ?? Array.Empty<AggregateCheckStatusInfo>();
    var attentionChecks = allChecks
        .Where(static check => check.State == AggregateCheckState.Fail || check.State == AggregateCheckState.Warning)
        .Take(8)
        .ToList();
    var detectedServiceViews = Microsoft365OverviewPresentation.BuildServices(tenant?.Services);
    var missingServices = (tenant?.Services ?? Array.Empty<Microsoft365ServiceDetection>())
        .Where(static service => service.Status != Microsoft365DetectionStatus.Detected)
        .Select(static service => service.Kind.ToString())
        .ToList();
    var identityCards = Microsoft365OverviewPresentation.BuildIdentityCards(Info);
    var serviceCoverageCards = Microsoft365OverviewPresentation.BuildServiceCoverageCards(Info);
    var tenantDomains = Microsoft365OverviewPresentation.BuildTenantDomains(tenant?.TenantDomains);
    var appGroups = DetectedApplicationPresentation.BuildCategories(tenant?.DetectedDnsApplications);
    var knownSubdomains = Microsoft365OverviewPresentation.BuildKnownSubdomains(tenant?.KnownSubdomains)
        .Take(18)
        .ToList();
    var domainCoverageCards = Microsoft365OverviewPresentation.BuildDomainCoverageCards(Info);
    var evidenceGroups = Microsoft365OverviewPresentation.BuildEvidenceCategories(tenant?.EvidenceLedger);
    var evidenceSummaryCards = Microsoft365OverviewPresentation.BuildEvidenceSummaryCards(evidenceGroups);
    var highlightCards = Microsoft365OverviewPresentation.BuildHighlightCards(Info);
    var snapshotHighlights = Microsoft365OverviewPresentation.BuildSnapshotHighlights(Info);
    var snapshotCards = Microsoft365OverviewPresentation.BuildSnapshotCards(Info);
    var assessmentSummaryCards = OverviewAssessmentPresentation.BuildSummaryCards(Info?.Assessments);
    var assessmentPreviewLines = OverviewAssessmentPresentation.BuildPreviewLines(Info?.Assessments, 5);
    var mailCards = Microsoft365OverviewPresentation.BuildMailCards(Info);
    var mailControlCards = OverviewControlPresentation.BuildAllCards(Info?.MailDnsChecks);
    var attentionControlCards = OverviewControlPresentation.BuildAttentionCards(allChecks);
    var healthyControlCards = OverviewControlPresentation.BuildHealthyCards(allChecks);
    var attentionCards = OverviewRecommendationPresentation.BuildProblemCards(Info?.Recommendations);
    var positiveCards = OverviewRecommendationPresentation.BuildPositiveCards(Info?.Positives);
    var noAttentionControlCard = OverviewEmptyStatePresentation.BuildCard("Controls needing follow-up", "No flagged controls", "DD did not surface a failing or warning mail or DNS control in this run.", new[] { "Mail and DNS baseline clean" });
    var noHealthyControlCard = OverviewEmptyStatePresentation.BuildCard("Healthy controls", "No clean pass state", "The current DD run did not return a clean pass state for a core control yet, so this dashboard is waiting on stronger healthy evidence.", new[] { "Review the control detail cards" });
    var noAttentionPlanCard = OverviewEmptyStatePresentation.BuildCard("Do next", "No urgent remediation", "The current DD assessment set did not emit an urgent remediation item for this tenant.", new[] { "Continue with the recommended deep checks" });
    var noPositivePlanCard = OverviewEmptyStatePresentation.BuildCard("Keep in place", "No separate positive item", "The run completed successfully, but DD did not emit a separate positive guidance item for this tenant in the current assessment set.", new[] { "Rely on the passing control and posture cards" });
    var noDetectedServiceCard = OverviewEmptyStatePresentation.BuildCard("Detected workloads", "No confident workload match", "No Microsoft 365 service family reached a confident detected state from the current public DD evidence.", new[] { "Review identity, domain, and evidence sections for weaker signals" });
    var allObservedServiceCard = OverviewEmptyStatePresentation.BuildCard("Not observed", "All modeled families observed", "All modeled Microsoft 365 service families produced public DD evidence in this run.", new[] { "Coverage is broad across the modeled workload set" });
    var noTenantDomainsCard = OverviewEmptyStatePresentation.BuildCard("Tenant domains", "No tenant-linked domains", "DD did not identify tenant-related domains from the current public Microsoft identity and namespace evidence.", new[] { "Review identity and evidence sections" });
    var noKnownSubdomainsCard = OverviewEmptyStatePresentation.BuildCard("Known subdomains", "No Microsoft-related subdomains", "DD did not identify a Microsoft-related subdomain pattern for this tenant in the current run.", new[] { "Public hostname footprint may be intentionally narrow" });
    var noAppsCard = OverviewEmptyStatePresentation.BuildCard("Detected DNS applications", "No application footprint", "DD did not match a DNS application or provider fingerprint for this tenant in the current run.", new[] { "Review domains and evidence for weaker Microsoft signals" });
    var noEvidenceCard = OverviewEmptyStatePresentation.BuildCard("Evidence ledger", "No DD evidence cards", "DD did not emit category-level evidence cards for this tenant yet, so the overview is currently relying on the control, domain, and identity sections.", new[] { "Run a deeper online scan for stronger evidence coverage" });
    var noAssessmentsCard = OverviewEmptyStatePresentation.BuildCard("Assessments", "No DD assessments", "This tenant run completed without DD assessments, warnings, or positive guidance items to display.", new[] { "Use the control and posture sections as the current source of truth" });
}

@if (Info is not null && tenant is not null) {
@if (Info.IsBrowserLimited) {
    <div class="tool-callout tool-callout-inline">
        <strong>Web edition overview</strong>
        <p>This view uses the DD checks that run cleanly in the browser. Sections that need deeper online validation stay visible below and are marked clearly.</p>
    </div>
}

@if (Info.IsPartial) {
    <div class="tool-callout tool-callout-inline">
        <strong>@(string.IsNullOrWhiteSpace(Info.StageLabel) ? "First pass ready" : Info.StageLabel)</strong>
        <p>The first DD pass is already on the page. Detailed sections are still loading for: @string.Join(", ", Info.PendingSections).</p>
    </div>
}

@if (Info.GeneratedAtUtc > DateTimeOffset.MinValue) {
    <div class="tool-meta-row">
        <span class="tool-meta-pill">Updated @FormatUtc(Info.GeneratedAtUtc)</span>
        <span class="tool-meta-pill">Age @FormatAge(Info.GeneratedAtUtc)</span>
        <span class="tool-meta-pill">@(Info.ServedFromCache ? "Saved result" : "Live result")</span>
        <span class="tool-meta-pill">@(Info.IsPartial ? "First pass" : "Full report")</span>
        @if (Info.CompletedAtUtc.HasValue) {
            <span class="tool-meta-pill">Completed @FormatUtc(Info.CompletedAtUtc.Value)</span>
        } else if (Info.PendingSections.Count > 0) {
            <span class="tool-meta-pill">@($"{Info.PendingSections.Count} sections loading")</span>
        }
    </div>
}

<div id="m365-snapshot" class="overview-section-anchor">
<div class="overview-section-state">
    <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Snapshot"), IsSectionUnavailable(Info, "Snapshot"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Snapshot"), IsSectionUnavailable(Info, "Snapshot"))</span>
    <span class="overview-section-state-text">@GetSectionStatusText(Info, IsSectionPending(Info, "Snapshot"), IsSectionUnavailable(Info, "Snapshot"), "Included in the first pass.", "Snapshot remains available in the web edition.")</span>
</div>
<ResultCard Title="Microsoft 365 tenant posture" Status="@GetOverallStatus(Info!)">
    <div class="tool-section-grid">
        @foreach (var card in snapshotCards) {
            <OverviewDetailCard Card="card" />
        }
    </div>

    <div class="tool-callout">
        <strong>@BuildSummary(Info)</strong>
        @if (snapshotHighlights.Count > 0) {
            <ul class="tool-bullet-list mt-2">
                @foreach (var item in snapshotHighlights) {
                    <li>@item</li>
                }
            </ul>
        } else {
            <p>@tenant.Summary</p>
        }
    </div>
</ResultCard>
</div>

<nav class="overview-quick-nav" aria-label="Microsoft 365 overview sections">
    <button type="button" class="overview-quick-link" @onclick='() => ScrollToSectionAsync("m365-snapshot")'>Snapshot <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Snapshot"), IsSectionUnavailable(Info, "Snapshot"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Snapshot"), IsSectionUnavailable(Info, "Snapshot"))</span></button>
    <button type="button" class="overview-quick-link" @onclick='() => ScrollToSectionAsync("m365-identity")'>Identity <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Identity"), IsSectionUnavailable(Info, "Identity"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Identity"), IsSectionUnavailable(Info, "Identity"))</span></button>
    <button type="button" class="overview-quick-link" @onclick='() => ScrollToSectionAsync("m365-services")'>Services <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Services"), IsSectionUnavailable(Info, "Services"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Services"), IsSectionUnavailable(Info, "Services"))</span></button>
    <button type="button" class="overview-quick-link" @onclick='() => ScrollToSectionAsync("m365-mail")'>Mail controls <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Mail controls"), IsSectionUnavailable(Info, "Mail controls"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Mail controls"), IsSectionUnavailable(Info, "Mail controls"))</span></button>
    <button type="button" class="overview-quick-link" @onclick='() => ScrollToSectionAsync("m365-apps")'>Apps <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Apps"), IsSectionUnavailable(Info, "Apps"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Apps"), IsSectionUnavailable(Info, "Apps"))</span></button>
    <button type="button" class="overview-quick-link" @onclick='() => ScrollToSectionAsync("m365-domains")'>Domains <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Domains"), IsSectionUnavailable(Info, "Domains"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Domains"), IsSectionUnavailable(Info, "Domains"))</span></button>
    <button type="button" class="overview-quick-link" @onclick='() => ScrollToSectionAsync("m365-evidence")'>Evidence <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Evidence"), IsSectionUnavailable(Info, "Evidence"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Evidence"), IsSectionUnavailable(Info, "Evidence"))</span></button>
    <button type="button" class="overview-quick-link" @onclick='() => ScrollToSectionAsync("m365-assessments")'>Assessments <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Assessments"), IsSectionUnavailable(Info, "Assessments"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Assessments"), IsSectionUnavailable(Info, "Assessments"))</span></button>
</nav>

<ResultCard Title="Control priorities" Status="ResultCard.ResultStatus.Info">
    <div class="tool-section-grid">
        <div class="tool-summary-card">
            <span class="tool-summary-label">Controls needing follow-up</span>
            @if (attentionControlCards.Count > 0) {
                <div class="tool-stack">
                    @foreach (var card in attentionControlCards) {
                        <OverviewControlCard Card="card" CalloutClass="@($"tool-callout tool-callout-control {card.StateClass}")" />
                    }
                </div>
            } else {
                <OverviewCalloutCard Card="noAttentionControlCard" CalloutClass="tool-callout tool-callout-control tool-callout-info" />
            }
        </div>
        <div class="tool-summary-card">
            <span class="tool-summary-label">Healthy controls</span>
            @if (healthyControlCards.Count > 0) {
                <div class="tool-stack">
                    @foreach (var card in healthyControlCards) {
                        <OverviewControlCard Card="card" CalloutClass="@($"tool-callout tool-callout-control {card.StateClass}")" />
                    }
                </div>
            } else {
                <OverviewCalloutCard Card="noHealthyControlCard" CalloutClass="tool-callout tool-callout-control tool-callout-info" />
            }
        </div>
    </div>
</ResultCard>

<ResultCard Title="Action plan" Status="ResultCard.ResultStatus.Info">
    <div class="tool-section-grid">
        <div class="tool-summary-card">
            <span class="tool-summary-label">Do next</span>
            @if (attentionCards.Count > 0) {
                <div class="tool-stack">
                    @foreach (var card in attentionCards) {
                        <OverviewCalloutCard Card="card" />
                    }
                </div>
            } else {
                <OverviewCalloutCard Card="noAttentionPlanCard" CalloutClass="tool-callout tool-callout-info" />
            }
        </div>
        <div class="tool-summary-card">
            <span class="tool-summary-label">Keep in place</span>
            @if (positiveCards.Count > 0) {
                <div class="tool-stack">
                    @foreach (var card in positiveCards) {
                        <OverviewCalloutCard Card="card" />
                    }
                </div>
            } else {
                <OverviewCalloutCard Card="noPositivePlanCard" CalloutClass="tool-callout tool-callout-info" />
            }
        </div>
    </div>
</ResultCard>

<ResultCard Title="Share and reopen" Status="ResultCard.ResultStatus.Info">
    <div class="tool-share-summary tool-share-summary-compact">
        <div class="tool-share-header">
            <div class="tool-share-header-copy">
                <strong>Permalink and copy-ready summary</strong>
                <p>Use this when you want to reopen the same result later or paste a short DD summary into a ticket or message.</p>
            </div>
            <a class="tool-share-link" href="@GetPermalinkUrl()" target="_blank" rel="noopener">Open result link</a>
        </div>
        <div class="tool-share-metrics">
            <span class="@GetShareRiskClass(Info)">@GetShareRiskLabel(Info)</span>
            <span class="tool-share-pill">Errors @Info.ErrorCount</span>
            <span class="tool-share-pill">Warnings @Info.WarningCount</span>
            <span class="tool-share-pill">Attention @attentionChecks.Count</span>
            <span class="@GetSharePendingClass(Info)">@GetSharePendingLabel(Info)</span>
            <span class="@GetShareSourceClass(Info.ServedFromCache)">@(Info.ServedFromCache ? "Saved result" : "Live result")</span>
        </div>
        <div class="tool-share-actions">
            <button type="button" class="tool-run-btn tool-run-btn-secondary" @onclick="CopySnapshotAsync">Copy summary</button>
            <button type="button" class="tool-run-btn tool-run-btn-secondary" @onclick="CopyRedFlagsAsync">Copy red flags</button>
            @if (!string.IsNullOrWhiteSpace(_copyStatus)) {
                <span class="tool-share-status">@_copyStatus</span>
            }
        </div>
        <details class="overview-disclosure tool-share-disclosure">
            <summary class="overview-disclosure-summary">Show copied summary</summary>
            <div class="overview-disclosure-body">
                <pre class="tool-share-summary-text">@BuildShareableSnapshot()</pre>
            </div>
        </details>
    </div>
</ResultCard>

<div id="m365-identity" class="overview-section-anchor">
<div class="overview-section-state">
    <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Identity"), IsSectionUnavailable(Info, "Identity"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Identity"), IsSectionUnavailable(Info, "Identity"))</span>
    <span class="overview-section-state-text">@GetSectionStatusText(Info, IsSectionPending(Info, "Identity"), IsSectionUnavailable(Info, "Identity"), "Identity and tenant signals are already available.", GetUnavailableSectionMessage("Identity"))</span>
</div>
@if (IsSectionUnavailable(Info, "Identity")) {
    <ResultCard Title="Tenant identity" Status="ResultCard.ResultStatus.Info">
        <p class="tool-summary-note">@GetUnavailableSectionMessage("Identity")</p>
    </ResultCard>
} else {
<ResultCard Title="Tenant identity" Status="ResultCard.ResultStatus.Info">
    <div class="tool-section-grid">
        @foreach (var card in identityCards) {
            <OverviewDetailCard Card="card" />
        }
    </div>
</ResultCard>
}
</div>

<div id="m365-services" class="overview-section-anchor">
<div class="overview-section-state">
    <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Services"), IsSectionUnavailable(Info, "Services"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Services"), IsSectionUnavailable(Info, "Services"))</span>
    <span class="overview-section-state-text">@GetSectionStatusText(Info, IsSectionPending(Info, "Services"), IsSectionUnavailable(Info, "Services"), "Detected Microsoft 365 service families are already available.", GetUnavailableSectionMessage("Services"))</span>
</div>
@if (IsSectionUnavailable(Info, "Services")) {
    <ResultCard Title="Detected Microsoft 365 services" Status="ResultCard.ResultStatus.Info">
        <p class="tool-summary-note">@GetUnavailableSectionMessage("Services")</p>
    </ResultCard>
} else {
<ResultCard Title="Detected Microsoft 365 services" Status="ResultCard.ResultStatus.Info">
    @if (serviceCoverageCards.Count > 0) {
        <div class="tool-section-grid mb-3">
            @foreach (var card in serviceCoverageCards) {
                <OverviewDetailCard Card="card" />
            }
        </div>
    }
    <div class="tool-section-grid">
        <div class="tool-summary-card">
            <span class="tool-summary-label">Detected workloads</span>
            @if (detectedServiceViews.Count > 0) {
                <p class="tool-summary-note">DD identified @detectedServiceViews.Count workload signal(s). Expand the list to review the strongest observed service families and their evidence.</p>
                <details class="overview-disclosure mt-2">
                    <summary class="overview-disclosure-summary">Show detected workloads (@detectedServiceViews.Count)</summary>
                    <div class="overview-disclosure-body">
                        <div class="tool-stack">
                            @foreach (var service in detectedServiceViews) {
                                <OverviewItemCallout
                                    Title="@service.Name"
                                    Summary="@service.Summary"
                                    Chips="@(new[] { $"Confidence: {service.ConfidenceLabel}", service.EvidenceSourceLabel, $"{service.ObservationCount} signal(s)" })"
                                    Samples="service.Samples" />
                            }
                        </div>
                    </div>
                </details>
            } else {
                <OverviewCalloutCard Card="noDetectedServiceCard" CalloutClass="tool-callout tool-callout-info" />
            }
        </div>
        <div class="tool-summary-card">
            <span class="tool-summary-label">Not observed</span>
            @if (missingServices.Count > 0) {
                <div class="tool-chip-list">
                    @foreach (var service in missingServices) {
                        <span class="tool-chip">@service</span>
                    }
                </div>
            } else {
                <OverviewCalloutCard Card="allObservedServiceCard" CalloutClass="tool-callout tool-callout-pass" />
            }
        </div>
    </div>
</ResultCard>
}
</div>

<div id="m365-mail" class="overview-section-anchor">
<div class="overview-section-state">
    <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Mail controls"), IsSectionUnavailable(Info, "Mail controls"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Mail controls"), IsSectionUnavailable(Info, "Mail controls"))</span>
    <span class="overview-section-state-text">@GetSectionStatusText(Info, IsSectionPending(Info, "Mail controls"), IsSectionUnavailable(Info, "Mail controls"), "Core mail and DNS controls are fully evaluated.", GetUnavailableSectionMessage("Mail controls"))</span>
</div>
@if (IsSectionUnavailable(Info, "Mail controls")) {
    <ResultCard Title="Mail and DNS controls" Status="ResultCard.ResultStatus.Info">
        <p class="tool-summary-note">@GetUnavailableSectionMessage("Mail controls")</p>
    </ResultCard>
} else {
<ResultCard Title="Mail and DNS controls" Status="ResultCard.ResultStatus.Info">
    <div class="overview-status-strip">
        @foreach (var card in mailControlCards) {
            <OverviewControlCard Card="card" CalloutClass="@($"tool-callout tool-callout-control {card.StateClass}")" Compact="true" />
        }
    </div>
    @if (mailCards.Count > 0) {
        <div class="tool-section-grid mt-3">
            @foreach (var card in mailCards) {
                <OverviewDetailCard Card="card" />
            }
        </div>
    }
</ResultCard>
}
</div>

<div id="m365-apps" class="overview-section-anchor">
    <div class="overview-section-state">
        <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Apps"), IsSectionUnavailable(Info, "Apps"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Apps"), IsSectionUnavailable(Info, "Apps"))</span>
        <span class="overview-section-state-text">@GetSectionStatusText(Info, IsSectionPending(Info, "Apps"), IsSectionUnavailable(Info, "Apps"), "Detected DNS application evidence is already available.", GetUnavailableSectionMessage("Apps"))</span>
    </div>
    <ResultCard Title="Detected DNS applications" Status="ResultCard.ResultStatus.Info">
        @if (appGroups.Count > 0) {
            <div class="tool-section-grid">
                @foreach (var group in appGroups) {
                    <div class="tool-summary-card">
                        <span class="tool-summary-label">@group.CategoryLabel</span>
                        <strong class="tool-summary-value">@group.ApplicationCount app(s)</strong>
                        <p class="tool-summary-note">DD matched @group.ApplicationCount application signal(s) in this category. Expand to review the detailed provider and evidence cards.</p>
                        <details class="overview-disclosure mt-2">
                            <summary class="overview-disclosure-summary">Show @group.CategoryLabel.ToLowerInvariant() matches (@group.Applications.Count)</summary>
                            <div class="overview-disclosure-body">
                                <div class="tool-stack">
                                    @foreach (var app in group.Applications) {
                                        <OverviewItemCallout
                                            Title="@app.Name"
                                            Summary="@app.Summary"
                                            Chips="@BuildAppChips(app)"
                                            Samples="app.Samples" />
                                    }
                                </div>
                            </div>
                        </details>
                    </div>
                }
            </div>
        } else {
            <OverviewCalloutCard Card="noAppsCard" CalloutClass="tool-callout tool-callout-info" />
        }
    </ResultCard>
</div>

<div id="m365-domains" class="overview-section-anchor">
<div class="overview-section-state">
    <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Domains"), IsSectionUnavailable(Info, "Domains"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Domains"), IsSectionUnavailable(Info, "Domains"))</span>
    <span class="overview-section-state-text">@GetSectionStatusText(Info, IsSectionPending(Info, "Domains"), IsSectionUnavailable(Info, "Domains"), "Tenant domains and known Microsoft 365 subdomains are already available.", GetUnavailableSectionMessage("Domains"))</span>
</div>
@if (IsSectionUnavailable(Info, "Domains")) {
    <ResultCard Title="Tenant domains and known subdomains" Status="ResultCard.ResultStatus.Info">
        <p class="tool-summary-note">@GetUnavailableSectionMessage("Domains")</p>
    </ResultCard>
} else {
<ResultCard Title="Tenant domains and known subdomains" Status="ResultCard.ResultStatus.Info">
    @if (domainCoverageCards.Count > 0) {
        <div class="tool-section-grid mb-3">
            @foreach (var card in domainCoverageCards) {
                <OverviewDetailCard Card="card" />
            }
        </div>
    }
    <div class="tool-section-grid">
        <div class="tool-summary-card">
            <span class="tool-summary-label">Tenant domains</span>
            @if (tenantDomains.Count > 0) {
                <p class="tool-summary-note">DD identified @tenantDomains.Count tenant-domain relationship(s). Expand for role, confidence, and evidence details.</p>
                <details class="overview-disclosure mt-2">
                    <summary class="overview-disclosure-summary">Show tenant domains (@tenantDomains.Count)</summary>
                    <div class="overview-disclosure-body">
                        <div class="tool-stack">
                            @foreach (var domain in tenantDomains) {
                                <OverviewItemCallout
                                    Title="@domain.Domain"
                                    Summary="@domain.Summary"
                                    Chips="@(new[] { domain.RoleLabel, $"Confidence: {domain.ConfidenceLabel}", $"{domain.ObservationCount} signal(s)" })"
                                    Samples="domain.Samples" />
                            }
                        </div>
                    </div>
                </details>
            } else {
                <OverviewCalloutCard Card="noTenantDomainsCard" CalloutClass="tool-callout tool-callout-info" />
            }
        </div>
        <div class="tool-summary-card">
            <span class="tool-summary-label">Known subdomains</span>
            @if (knownSubdomains.Count > 0) {
                <p class="tool-summary-note">DD observed @knownSubdomains.Count Microsoft 365-related subdomain signal(s). Expand for resolution and evidence details.</p>
                <details class="overview-disclosure mt-2">
                    <summary class="overview-disclosure-summary">Show known subdomains (@knownSubdomains.Count)</summary>
                    <div class="overview-disclosure-body">
                        <div class="tool-stack">
                            @foreach (var subdomain in knownSubdomains) {
                                <OverviewItemCallout
                                    Title="@subdomain.Name"
                                    Summary="@subdomain.Summary"
                                    Chips="@(new[] { subdomain.RoleLabel, subdomain.ResolutionLabel, $"{subdomain.ObservationCount} signal(s)" })"
                                    Samples="subdomain.Samples" />
                            }
                        </div>
                    </div>
                </details>
            } else {
                <OverviewCalloutCard Card="noKnownSubdomainsCard" CalloutClass="tool-callout tool-callout-info" />
            }
        </div>
    </div>
</ResultCard>
}
</div>

<div id="m365-evidence" class="overview-section-anchor">
    <div class="overview-section-state">
        <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Evidence"), IsSectionUnavailable(Info, "Evidence"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Evidence"), IsSectionUnavailable(Info, "Evidence"))</span>
        <span class="overview-section-state-text">@GetSectionStatusText(Info, IsSectionPending(Info, "Evidence"), IsSectionUnavailable(Info, "Evidence"), "The evidence ledger explains why DD inferred the tenant posture.", GetUnavailableSectionMessage("Evidence"))</span>
    </div>
    <ResultCard Title="Why DD inferred Microsoft 365" Status="ResultCard.ResultStatus.Info">
        @if (evidenceGroups.Count > 0 && evidenceSummaryCards.Count > 0) {
            <div class="tool-section-grid mb-3">
                @foreach (var card in evidenceSummaryCards) {
                    <OverviewDetailCard Card="card" />
                }
            </div>
        }
        @if (evidenceGroups.Count > 0) {
            <details class="overview-disclosure">
                <summary class="overview-disclosure-summary">Show evidence details (@evidenceGroups.Count categories)</summary>
                <div class="overview-disclosure-body">
                    <div class="tool-section-grid">
                        @foreach (var group in evidenceGroups) {
                            <div class="tool-summary-card">
                                <span class="tool-summary-label">@group.CategoryLabel</span>
                                <strong class="tool-summary-value">@group.ItemCount signal(s)</strong>
                                <p class="tool-summary-note">Strongest confidence: @group.HighestConfidenceLabel</p>
                                <div class="tool-stack">
                                    @foreach (var item in group.Items.Take(4)) {
                                        <OverviewItemCallout
                                            Title="@item.Label"
                                            Summary="@item.Summary"
                                            Chips="@(new[] { $"Confidence: {item.ConfidenceLabel}", $"{item.ObservationCount} signal(s)" })"
                                            Samples="item.Samples" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </details>
        } else {
            <OverviewCalloutCard Card="noEvidenceCard" CalloutClass="tool-callout tool-callout-info" />
        }
    </ResultCard>
</div>

@if (highlightCards.Count > 0) {
    <ResultCard Title="Posture notes" Status="ResultCard.ResultStatus.Info">
        <div class="tool-section-grid">
            @foreach (var card in highlightCards) {
                <OverviewDetailCard Card="card" />
            }
        </div>
    </ResultCard>
}

<div id="m365-assessments" class="overview-section-anchor">
<div class="overview-section-state">
    <span class="@GetSectionBadgeClass(IsSectionPending(Info, "Assessments"), IsSectionUnavailable(Info, "Assessments"))">@GetSectionBadgeLabel(IsSectionPending(Info, "Assessments"), IsSectionUnavailable(Info, "Assessments"))</span>
    <span class="overview-section-state-text">@GetSectionStatusText(Info, IsSectionPending(Info, "Assessments"), IsSectionUnavailable(Info, "Assessments"), "All DD recommendations and positive findings are included.", GetUnavailableSectionMessage("Assessments"))</span>
</div>
<ResultCard Title="Assessments" Status="ResultCard.ResultStatus.Info">
    @if (Info.Assessments.Count > 0) {
        @if (assessmentSummaryCards.Count > 0) {
            <div class="tool-section-grid mb-3">
                @foreach (var card in assessmentSummaryCards) {
                    <OverviewDetailCard Card="card" />
                }
            </div>
        }
        @if (assessmentPreviewLines.Count > 0) {
            <div class="tool-callout tool-callout-inline tool-callout-soft">
                <strong>Top findings</strong>
                <ul class="tool-bullet-list">
                    @foreach (var item in assessmentPreviewLines) {
                        <li>@item</li>
                    }
                </ul>
            </div>
        }
        <details class="overview-disclosure">
            <summary class="overview-disclosure-summary">Show findings (@Info.Assessments.Count)</summary>
            <div class="overview-disclosure-body">
                <AssessmentList Assessments="Info.Assessments" EmptyMessage="No assessments were produced for this tenant." />
            </div>
        </details>
    } else {
        <OverviewCalloutCard Card="noAssessmentsCard" CalloutClass="tool-callout tool-callout-info" />
    }
</ResultCard>
</div>
}

@code {
    [Parameter] public string? PermalinkUrl { get; set; }

    [Parameter] public required Microsoft365OverviewInfo Info { get; set; }
    [Parameter] public required string Domain { get; set; }
    private string? _copyStatus;

    private string GetPermalinkUrl() {
        return string.IsNullOrWhiteSpace(PermalinkUrl) ? Navigation.Uri : PermalinkUrl;
    }

    private async Task ScrollToSectionAsync(string sectionId) {
        await JS.InvokeVoidAsync("domainDetectiveTools.scrollToElement", sectionId);
    }

    private async Task CopySnapshotAsync() {
        var copied = await JS.InvokeAsync<bool>("domainDetectiveTools.copyText", BuildShareableSnapshot());
        _copyStatus = copied ? "Snapshot copied to clipboard." : "Copy failed. You can still select the text manually.";
    }

    private async Task CopyRedFlagsAsync() {
        var copied = await JS.InvokeAsync<bool>("domainDetectiveTools.copyText", BuildRedFlagsSnapshot());
        _copyStatus = copied ? "Red-flags snapshot copied to clipboard." : "Copy failed. You can still select the text manually.";
    }

    private static ResultCard.ResultStatus GetOverallStatus(Microsoft365OverviewInfo info) {
        if (info.ErrorCount > 0) {
            return ResultCard.ResultStatus.Fail;
        }

        if (info.WarningCount > 0) {
            return ResultCard.ResultStatus.Warning;
        }

        return info.Tenant.IsMicrosoft365Tenant ? ResultCard.ResultStatus.Pass : ResultCard.ResultStatus.Info;
    }

    private static IReadOnlyList<string> BuildAppChips(DetectedApplicationItemView app) {
        var chips = new List<string> {
            $"Confidence: {app.ConfidenceLabel}",
            $"{app.ObservationCount} observation(s)"
        };

        if (!string.IsNullOrWhiteSpace(app.SourceLabel)) {
            chips.Add(app.SourceLabel);
        }

        if (app.Signals.Count > 0) {
            chips.AddRange(app.Signals);
        }

        return chips;
    }

    private static string BuildSummary(Microsoft365OverviewInfo info) {
        if (info.IsBrowserLimited) {
            return "Web edition Microsoft 365 report built from web-ready DNS and mail evidence. Identity probing and tenant-correlation sections are marked clearly when they need deeper online validation.";
        }

        if (!info.Tenant.IsMicrosoft365Tenant) {
            return "The public signals do not strongly confirm Microsoft 365 for this domain yet.";
        }

        return $"{info.DetectedServiceCount} Microsoft 365 service families detected with {info.DetectedApplicationCount} DNS application footprints and {info.KnownSubdomainCount} recognized subdomains.";
    }

    private string BuildShareableSnapshot() {
        var info = Info;
        var source = info.ServedFromCache ? "Saved result" : "Live result";
        var stage = info.IsPartial ? "First pass" : "Full report";
        var warnings = info.WarningCount;
        var errors = info.ErrorCount;
        var pending = info.PendingSections.Count == 0 ? "None" : string.Join(", ", info.PendingSections);
        var unavailable = info.UnavailableSections.Count == 0 ? "None" : string.Join(", ", info.UnavailableSections);
        var tenantName = string.IsNullOrWhiteSpace(info.Tenant.TenantName) ? "Unknown" : info.Tenant.TenantName;
        var identity = FormatIdentityPosture(info.Tenant);
        var acceptedDomains = info.AcceptedDomainCount;
        var detectedServices = info.DetectedServiceCount;
        var mailSummary = string.Join(", ", info.MailDnsChecks.Select(static check => $"{check.Label}={check.Value}"));

        return string.Join(Environment.NewLine, new[] {
            $"Domain Detective M365 overview for {info.Subject}",
            $"Permalink: {Navigation.Uri}",
            $"Stage: {stage}",
            $"Source: {source}",
            $"Risk: {GetShareRiskLabel(info)}",
            $"Updated: {FormatUtc(info.GeneratedAtUtc)}",
            $"Pending sections: {pending}",
            $"Unavailable sections: {unavailable}",
            $"Tenant: {tenantName}",
            $"Identity: {identity}",
            $"Detected services: {detectedServices}",
            $"Accepted domains: {acceptedDomains}",
            $"Warnings/Errors: {warnings}/{errors}",
            $"Mail controls: {mailSummary}"
        });
    }

    private string BuildRedFlagsSnapshot() {
        var info = Info;
        var lines = new List<string> {
            $"Domain Detective M365 red flags for {info.Subject}",
            $"Permalink: {Navigation.Uri}",
            $"Stage: {(info.IsPartial ? "First pass" : "Full report")}",
            $"Source: {(info.ServedFromCache ? "Saved result" : "Live result")}",
            $"Risk: {GetShareRiskLabel(info)}",
            $"Updated: {FormatUtc(info.GeneratedAtUtc)}",
            $"Warnings/Errors: {info.WarningCount}/{info.ErrorCount}",
            $"Unavailable sections: {(info.UnavailableSections.Count == 0 ? "None" : string.Join(", ", info.UnavailableSections))}"
        };

        var failingChecks = info.MailDnsChecks
            .Where(static check => check.State == AggregateCheckState.Fail || check.State == AggregateCheckState.Warning)
            .Take(8)
            .Select(static check => $"{check.Label}: {check.Value} ({check.Detail})")
            .ToList();

        if (failingChecks.Count > 0) {
            lines.Add("Priority controls:");
            lines.AddRange(failingChecks.Select(static item => "- " + item));
        } else {
            lines.Add("Priority controls: none flagged in the current DD control strip.");
        }

        var recommendations = info.Recommendations.Take(5).Select(static item => $"{item.Title}: {item.Why}").ToList();
        if (recommendations.Count > 0) {
            lines.Add("Top recommendations:");
            lines.AddRange(recommendations.Select(static item => "- " + item));
        }

        return string.Join(Environment.NewLine, lines);
    }

    private static string FormatIdentityPosture(Microsoft365TenantInfo tenant) {
        if (tenant.IdentityProviderKind != TenantIdentityProviderKind.Unknown) {
            return tenant.IdentityProviderKind.ToString();
        }

        if (!string.IsNullOrWhiteSpace(tenant.IdentityProvider)) {
            return tenant.IdentityProvider;
        }

        return "Unknown";
    }

    private static string FormatValue(string? value, string fallback) {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string FormatUtc(DateTimeOffset timestamp) {
        return timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string FormatAge(DateTimeOffset timestamp) {
        var age = DateTimeOffset.UtcNow - timestamp;
        if (age.TotalSeconds < 60) {
            return $"{Math.Max(1, (int)age.TotalSeconds)}s ago";
        }

        if (age.TotalMinutes < 60) {
            return $"{(int)age.TotalMinutes}m ago";
        }

        if (age.TotalHours < 24) {
            return $"{(int)age.TotalHours}h ago";
        }

        return $"{(int)age.TotalDays}d ago";
    }

    private static string FormatCsv(IReadOnlyList<string>? values, string fallback) {
        if (values is null || values.Count == 0) {
            return fallback;
        }

        return string.Join(", ", values);
    }

    private static bool IsSectionPending(Microsoft365OverviewInfo info, string section) {
        return section switch {
            "Mail controls" => HasPending(info, "MTA-STS", "TLS-RPT", "BIMI", "CAA", "DANE", "DNSSEC"),
            "Assessments" => HasPending(info, "Deep recommendations"),
            _ => false
        };
    }

    private static bool IsSectionUnavailable(Microsoft365OverviewInfo info, string section) {
        return info.UnavailableSections.Any(item => string.Equals(item, section, StringComparison.OrdinalIgnoreCase));
    }

    private static bool HasPending(Microsoft365OverviewInfo info, params string[] sections) {
        return sections.Any(section => info.PendingSections.Any(pending => string.Equals(pending, section, StringComparison.OrdinalIgnoreCase)));
    }

    private static string GetSectionBadgeClass(bool isPending, bool isUnavailable) {
        if (isUnavailable) {
            return "overview-section-badge overview-section-badge-unavailable";
        }

        return isPending ? "overview-section-badge overview-section-badge-pending" : "overview-section-badge overview-section-badge-ready";
    }

    private static string GetSectionBadgeLabel(bool isPending, bool isUnavailable) {
        if (isUnavailable) {
            return "Unavailable";
        }

        return isPending ? "Loading" : "Ready";
    }

    private static string GetShareRiskClass(Microsoft365OverviewInfo info) {
        if (info.ErrorCount > 0) {
            return "tool-share-pill tool-share-pill-risk-high";
        }

        if (info.WarningCount > 0 || info.PendingSections.Count > 0) {
            return "tool-share-pill tool-share-pill-risk-medium";
        }

        return "tool-share-pill tool-share-pill-risk-low";
    }

    private static string GetShareRiskLabel(Microsoft365OverviewInfo info) {
        if (info.ErrorCount > 0) {
            return "High risk";
        }

        if (info.WarningCount > 0) {
            return "Needs review";
        }

        if (info.UnavailableSections.Count > 0) {
            return "Web edition";
        }

        if (info.PendingSections.Count > 0) {
            return "First pass";
        }

        return "Healthy baseline";
    }

    private static string GetSharePendingClass(Microsoft365OverviewInfo info) {
        if (info.UnavailableSections.Count > 0) {
            return "tool-share-pill tool-share-pill-unavailable";
        }

        return info.PendingSections.Count > 0
            ? "tool-share-pill tool-share-pill-pending"
            : "tool-share-pill tool-share-pill-complete";
    }

    private static string GetSharePendingLabel(Microsoft365OverviewInfo info) {
        if (info.UnavailableSections.Count > 0) {
            return $"{info.UnavailableSections.Count} sections unavailable";
        }

        return info.PendingSections.Count > 0
            ? $"{info.PendingSections.Count} sections loading"
            : "Full report";
    }

    private static string GetShareSourceClass(bool servedFromCache) {
        return servedFromCache
            ? "tool-share-pill tool-share-pill-cached"
            : "tool-share-pill tool-share-pill-fresh";
    }

    private static string GetSectionStatusText(Microsoft365OverviewInfo info, bool isPending, bool isUnavailable, string readyText, string unavailableText) {
        if (isUnavailable) {
            return unavailableText;
        }

        if (isPending) {
            return "Detailed checks for this section are still loading.";
        }

        if (info.IsPartial) {
            return readyText;
        }

        return readyText;
    }

    private static string GetUnavailableSectionMessage(string section) {
        return section switch {
            "Identity" => "Tenant identity and Microsoft authentication probing are unavailable in the web edition.",
            "Services" => "Microsoft workload detection in this section depends on identity and tenant correlation that the web edition does not run.",
            "Domains" => "Tenant domain and Microsoft subdomain correlation are unavailable in the web edition.",
            _ => "This section is unavailable in the web edition."
        };
    }

    private static string GetStatusStripClass(AggregateCheckState state) => state switch {
        AggregateCheckState.Pass => "overview-status-card overview-status-pass",
        AggregateCheckState.Warning => "overview-status-card overview-status-warning",
        AggregateCheckState.Fail => "overview-status-card overview-status-fail",
        _ => "overview-status-card overview-status-info"
    };
}
