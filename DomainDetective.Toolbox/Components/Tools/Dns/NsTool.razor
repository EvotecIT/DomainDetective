@using DomainDetective.Toolbox.Components.Shared

@if (HealthCheck.NSAnalysis is { } nameservers) {
    var matchKnown = nameservers.NsLookupComplete && nameservers.ParentNsRecords.Count > 0;
    var glueKnown = nameservers.DelegationAnalysisComplete || nameservers.GlueRecordsComplete;
    var consistencyKnown = nameservers.DelegationAnalysisComplete && nameservers.GlueRecordsComplete;
    <ResultCard Title="Nameserver posture" Status="@(!nameservers.NsLookupComplete ? ResultCard.ResultStatus.Warning : !nameservers.NsRecordExists ? ResultCard.ResultStatus.Fail : GetStatus(nameservers.Assessments))">
        <div class="tool-summary-grid">
            <div class="tool-summary-card">
                <span class="tool-summary-label">Published NS</span>
                <strong class="tool-summary-value">@(nameservers.NsLookupComplete ? nameservers.NsRecords.Count.ToString() : "Unknown")</strong>
                <p class="tool-summary-note">At least two: @FormatKnown(nameservers.AtLeastTwoRecords, nameservers.NsLookupComplete)</p>
            </div>
            <div class="tool-summary-card">
                <span class="tool-summary-label">Glue coverage</span>
                <strong class="tool-summary-value">@(!glueKnown ? "Unverified" : nameservers.GlueRecordsComplete ? "Complete" : "Incomplete")</strong>
                <p class="tool-summary-note">Consistent: @FormatKnown(nameservers.GlueRecordsConsistent, consistencyKnown)</p>
            </div>
            <div class="tool-summary-card">
                <span class="tool-summary-label">Diversity</span>
                <strong class="tool-summary-value">@(nameservers.AsnDiversityComplete ? $"{nameservers.AsnDistinctCount} ASN" : nameservers.AsnDistinctCount > 0 ? $"{nameservers.AsnDistinctCount}+ ASN (partial)" : "Unverified")</strong>
                <p class="tool-summary-note">Delegation matches: @FormatKnown(nameservers.DelegationMatches, matchKnown)</p>
            </div>
        </div>

        @if (nameservers.NsRecords.Count > 0) {
            <div class="tool-stack">
                <div>
                    <span class="tool-summary-label">Authoritative nameservers</span>
                    <div class="tool-chip-list">
                        @foreach (var nsRecord in nameservers.NsRecords) {
                            <span class="tool-chip">@nsRecord</span>
                        }
                    </div>
                </div>

                @if (nameservers.ParentNsRecords.Count > 0) {
                    <div>
                        <span class="tool-summary-label">Parent delegation</span>
                        <div class="tool-chip-list">
                            @foreach (var nsRecord in nameservers.ParentNsRecords) {
                                <span class="tool-chip">@nsRecord</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <ResultTable Columns="@(new[] { "Property", "Value" })">
            <tr><td>Duplicate records</td><td>@FormatKnown(nameservers.HasDuplicates, nameservers.NsLookupComplete)</td></tr>
            <tr><td>All hosts have A or AAAA</td><td>@FormatKnown(nameservers.AllHaveAOrAaaa, nameservers.AddressResultKnown)</td></tr>
            <tr><td>NS points to CNAME</td><td>@FormatKnown(nameservers.PointsToCname, nameservers.CnameResultKnown)</td></tr>
            <tr><td>Diverse locations</td><td>@FormatKnown(nameservers.HasDiverseLocations, nameservers.DiversityResultKnown)</td></tr>
            <tr><td>Delegation matches parent</td><td>@FormatKnown(nameservers.DelegationMatches, matchKnown)</td></tr>
        </ResultTable>
    </ResultCard>

    <ResultCard Title="Assessments" Status="ResultCard.ResultStatus.Info">
        <AssessmentList Assessments="nameservers.Assessments" EmptyMessage="@(nameservers.NsLookupComplete ? $"Child NS analysis complete for {Domain}. Parent delegation and glue are checked separately." : $"NS discovery did not complete for {Domain}; record presence is unknown.")" />
    </ResultCard>
}

@code {
    [Parameter] public required DomainDetective.DomainHealthCheck HealthCheck { get; set; }
    [Parameter] public required string Domain { get; set; }

    private static string FormatKnown(bool value, bool known) => !known ? "Unverified" : value ? "Yes" : "No";

    private static ResultCard.ResultStatus GetStatus(IReadOnlyList<DomainDetective.Assessment> assessments) {
        if (assessments.Any(static a => a.Severity == DomainDetective.AssessmentSeverity.Error)) {
            return ResultCard.ResultStatus.Fail;
        }

        if (assessments.Any(static a => a.Severity == DomainDetective.AssessmentSeverity.Warning)) {
            return ResultCard.ResultStatus.Warning;
        }

        return ResultCard.ResultStatus.Pass;
    }
}
