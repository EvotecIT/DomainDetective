@using DomainDetective.Toolbox.Components.Shared

@if (HealthCheck.DmarcAnalysis is { } dmarc) {
    <ResultCard Title="DMARC Record" Status="@(dmarc.DmarcRecordExists ? ResultCard.ResultStatus.Pass : ResultCard.ResultStatus.Fail)">
        @if (dmarc.DmarcRecordExists && dmarc.DmarcRecord is not null) {
            <div class="result-record">@dmarc.DmarcRecord</div>
            <ResultTable Columns="@(new[] { "Property", "Value" })">
                @if (dmarc.PolicyShort is not null) {
                    <tr><td>Policy</td><td>@dmarc.PolicyShort</td></tr>
                }
            </ResultTable>
        } else {
            <p>No DMARC record found for @Domain</p>
        }
    </ResultCard>

    @if (dmarc.Assessments?.Count > 0) {
        <ResultCard Title="Assessments">
            <ul class="issues-list">
                @foreach (var a in dmarc.Assessments) {
                    <li>
                        <span class="status-badge @GetAssessmentCss(a)">@a.Severity</span>
                        <span><strong>@(a.Code ?? a.Category)</strong> — @a.Message</span>
                    </li>
                }
            </ul>
        </ResultCard>
    }
}

@code {
    [Parameter] public required DomainDetective.DomainHealthCheck HealthCheck { get; set; }
    [Parameter] public required string Domain { get; set; }

    private string GetAssessmentCss(DomainDetective.Assessment a) => a.Severity switch {
        DomainDetective.AssessmentSeverity.Error => "status-badge-fail",
        DomainDetective.AssessmentSeverity.Warning => "status-badge-warning",
        DomainDetective.AssessmentSeverity.Info => "status-badge-info",
        _ => "status-badge-info"
    };
}
