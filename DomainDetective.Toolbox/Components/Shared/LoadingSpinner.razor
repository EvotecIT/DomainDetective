<div style="text-align: center; padding: 2rem;">
    <div class="loading-spinner"></div>
    @if (!string.IsNullOrEmpty(Message)) {
        <p style="margin-top: 1rem; color: var(--dd-muted);">@Message</p>
    }
</div>

@code {
    [Parameter] public string? Message { get; set; } = "Analyzing...";
}
