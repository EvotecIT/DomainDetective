@using DomainDetective.Toolbox.Models
@using DomainDetective.Toolbox.Services
@using DomainDetective.Views
@using Microsoft.JSInterop
@implements IDisposable
@inject BrowserDnsService DnsService
@inject BrowserOverviewService BrowserOverviewService
@inject HostedAnalysisService HostedAnalysisService
@inject ToolAvailabilityService Availability
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="tool-page @(IsOverviewTool(Definition) ? "tool-page-overview" : string.Empty)">
    <div class="tool-breadcrumb">
        <a href="/tools/">Tools</a> / @ToolRegistry.GetCategoryDisplayName(Definition.Category) / @Definition.Name
    </div>

    <div class="tool-page-header">
        <h1>@Definition.Name</h1>
        <p>@Definition.Description</p>
    </div>

    @if (!CanRunOnline(Definition)) {
        <ToolNotAvailable Tool="Definition" />
    } else if (UsesCustomToolLayout(Definition)) {
        @switch (Definition.Slug) {
            case "raw-dns-query":
                <DomainDetective.Toolbox.Components.Tools.Dns.RawDnsQueryTool />
                break;
            default:
                <ToolNotAvailable Tool="Definition" />
                break;
        }
    } else {
        @if (Definition.Slug == "dns-lookup") {
            <div class="tool-callout tool-callout-inline">
                <strong>Need raw record-by-record queries?</strong>
                <p>Use <a href="/tools/raw-dns-query/">Raw DNS Query</a> when you want to choose record types, inspect live JSON answers, and copy equivalent DnsClientX code for C# or PowerShell.</p>
            </div>
        }

        @if (Availability.IsStaticOnly && SupportsLiteTool(Definition)) {
            <div class="tool-callout tool-callout-inline">
                <strong>@GetStaticEditionTitle(Definition)</strong>
                <p>@GetStaticEditionDescription(Definition)</p>
            </div>
        }

        <form class="tool-input-form" @onsubmit="RunAnalysis" @onsubmit:preventDefault>
            <input type="text" @bind="_domain" placeholder="@(Definition.InputPlaceholder ?? "example.com")" />
            @if (Definition.SecondaryInputLabel is not null) {
                <input type="text"
                       @bind="_secondaryInput"
                       placeholder="@(Definition.SecondaryInputPlaceholder ?? "")"
                       aria-label="@Definition.SecondaryInputLabel"
                       title="@Definition.SecondaryInputLabel"
                       class="tool-input-secondary" />
            }
            <button type="submit" class="tool-run-btn" disabled="@_isLoading">
                @(_isLoading ? "Analyzing..." : "Analyze")
            </button>
            @if (SupportsHostedCache(Definition)) {
                <button type="button" class="tool-run-btn tool-run-btn-secondary" @onclick="RunFreshAnalysis" disabled="@_isLoading">
                    @(_isLoading ? "Working..." : "Refresh")
                </button>
            }
        </form>

        @if (_recentRuns.Count > 0) {
            <div class="tool-history-row" aria-label="Recent runs">
                <span class="tool-history-label">Recent runs</span>
                @foreach (var item in _recentRuns) {
                    <button type="button" class="tool-history-chip" @onclick="() => RunRecentAsync(item)">
                        <span>@item.Domain</span>
                        @if (!string.IsNullOrWhiteSpace(item.SecondaryInput)) {
                            <span class="tool-history-chip-muted">@item.SecondaryInput</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.DnsHost)) {
                            <span class="tool-history-chip-muted">@item.DnsHost</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.DnsResolver)) {
                            <span class="tool-history-chip-muted">@item.DnsResolver</span>
                        }
                    </button>
                }
            </div>
        }

        @if (_isLoading || _isHydratingDeep) {
            <div class="tool-progress-panel" role="status" aria-live="polite">
                <div class="tool-progress-header">
                    <strong>@GetProgressTitle()</strong>
                    <span class="tool-progress-value">@GetProgressLabel()</span>
                </div>
                <p>@GetProgressDescription()</p>
                <div class="tool-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@GetProgressPercentage()">
                    <span class="tool-progress-fill" style="width: @(GetProgressPercentage())%;"></span>
                </div>
                @if (IsOverviewTool(Definition)) {
                    <div class="tool-progress-steps" aria-label="Overview progress">
                        <span class="@GetProgressStepClass(_quickReadyAt.HasValue || _isHydratingDeep || _deepReadyAt.HasValue, _isLoading && !_quickReadyAt.HasValue)">1. First pass</span>
                        <span class="@GetProgressStepClass(_deepReadyAt.HasValue, _isHydratingDeep)">2. Detailed checks</span>
                    </div>
                }
                @if (IsOverviewTool(Definition) && _isHydratingDeep) {
                    <div class="tool-meta-row">
                        <span class="tool-meta-pill">First pass ready</span>
                        @foreach (var item in GetPendingSections()) {
                            <span class="tool-meta-pill">@item</span>
                        }
                    </div>
                }
            </div>
        }

        @if (_error is not null) {
            <ResultCard Title="Error" Status="ResultCard.ResultStatus.Fail">
                <p>@_error</p>
            </ResultCard>
        }

        @if ((_healthCheck is not null || _httpInfo is not null || _securityTxtInfo is not null || _certificateInfo is not null || _bimiInfo is not null || _mtastsInfo is not null || _rdapInfo is not null || _dnsPropagationInfo is not null || _subdomainsInfo is not null || _microsoft365OverviewInfo is not null || _domainOverviewInfo is not null) && !_isLoading) {
            @if (_isHydratingDeep) {
                <div class="tool-callout tool-callout-inline">
                    <strong>Building detailed sections</strong>
                    <p>The first results are ready. DomainDetective is still filling in the deeper sections and will update this page automatically when it finishes.</p>
                    <div class="tool-meta-row">
                        <span class="tool-meta-pill">Started @FormatTimestamp(_scanStartedAt)</span>
                        <span class="tool-meta-pill">First pass @FormatTimestamp(_quickReadyAt)</span>
                        <span class="tool-meta-pill">Detailed checks pending</span>
                    </div>
                </div>
            } else if (!string.IsNullOrWhiteSpace(_backgroundError)) {
                <div class="tool-callout tool-callout-inline">
                    <strong>Detailed checks did not finish loading</strong>
                    <p>@_backgroundError</p>
                    <div class="tool-meta-row">
                        <span class="tool-meta-pill">Started @FormatTimestamp(_scanStartedAt)</span>
                        <span class="tool-meta-pill">First pass @FormatTimestamp(_quickReadyAt)</span>
                    </div>
                </div>
            }

            @switch (Definition.Slug) {
                case "m365-overview":
                    <DomainDetective.Toolbox.Components.Tools.Overview.M365OverviewTool Info="_microsoft365OverviewInfo!" Domain="@_domain" PermalinkUrl="@BuildPermalinkUrl()" />
                    break;
                case "domain-overview":
                    <DomainDetective.Toolbox.Components.Tools.Overview.DomainOverviewTool Info="_domainOverviewInfo!" Domain="@_domain" PermalinkUrl="@BuildPermalinkUrl()" />
                    break;
                case "spf":
                    <DomainDetective.Toolbox.Components.Tools.EmailSecurity.SpfTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "dkim":
                    <DomainDetective.Toolbox.Components.Tools.EmailSecurity.DkimTool HealthCheck="_healthCheck" Domain="@_domain" Selector="@(_secondaryInput ?? string.Empty)" />
                    break;
                case "dmarc":
                    <DomainDetective.Toolbox.Components.Tools.EmailSecurity.DmarcTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "mx":
                    <DomainDetective.Toolbox.Components.Tools.EmailSecurity.MxTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "mta-sts":
                    <DomainDetective.Toolbox.Components.Tools.EmailSecurity.MtaStsTool HealthCheck="_healthCheck" Info="_mtastsInfo" Domain="@_domain" />
                    break;
                case "tls-rpt":
                    <DomainDetective.Toolbox.Components.Tools.EmailSecurity.TlsRptTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "bimi":
                    <DomainDetective.Toolbox.Components.Tools.EmailSecurity.BimiTool HealthCheck="_healthCheck" Info="_bimiInfo" Domain="@_domain" />
                    break;
                case "dns-lookup":
                    <DomainDetective.Toolbox.Components.Tools.Dns.DnsLookupTool HealthCheck="_healthCheck"
                                                                                Domain="@_domain"
                                                                                RequestedTypes="@_dnsRequestedTypes"
                                                                                HostLabel="@_dnsHostLabel"
                                                                                BrowserResolverName="@_dnsBrowserResolverName" />
                    break;
                case "dnssec":
                    <DomainDetective.Toolbox.Components.Tools.Dns.DnssecTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "soa":
                    <DomainDetective.Toolbox.Components.Tools.Dns.SoaTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "ns":
                    <DomainDetective.Toolbox.Components.Tools.Dns.NsTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "dns-propagation":
                    <DomainDetective.Toolbox.Components.Tools.Dns.DnsPropagationTool HealthCheck="_healthCheck" Info="_dnsPropagationInfo" Domain="@_domain" />
                    break;
                case "caa":
                    <DomainDetective.Toolbox.Components.Tools.TlsCert.CaaTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "dane":
                    <DomainDetective.Toolbox.Components.Tools.TlsCert.DaneTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "cert-check":
                    <DomainDetective.Toolbox.Components.Tools.TlsCert.CertificateTool Info="_certificateInfo" Domain="@_domain" />
                    break;
                case "http-headers":
                    <DomainDetective.Toolbox.Components.Tools.WebSecurity.HttpHeadersTool HealthCheck="_healthCheck" Info="_httpInfo" Domain="@_domain" />
                    break;
                case "security-txt":
                    <DomainDetective.Toolbox.Components.Tools.WebSecurity.SecurityTxtTool HealthCheck="_healthCheck" Info="_securityTxtInfo" Domain="@_domain" />
                    break;
                case "rdap":
                    <DomainDetective.Toolbox.Components.Tools.Registration.RdapTool HealthCheck="_healthCheck" Info="_rdapInfo" Domain="@_domain" />
                    break;
                case "dnsbl":
                    <DomainDetective.Toolbox.Components.Tools.ThreatIntel.DnsblTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "dangling-cname":
                    <DomainDetective.Toolbox.Components.Tools.ThreatIntel.DanglingCnameTool HealthCheck="_healthCheck" Domain="@_domain" />
                    break;
                case "ct-subdomains":
                    <DomainDetective.Toolbox.Components.Tools.Subdomain.CtSubdomainTool HealthCheck="_healthCheck" Info="_subdomainsInfo" Domain="@_domain" />
                    break;
            }
        }
    }

    @if (!UsesCustomToolLayout(Definition)) {
        <ToolUsageExamples Definition="Definition" />
    }
</div>

@code {
    [Parameter] public required ToolDefinition Definition { get; set; }

    private string _domain = "";
    private string? _secondaryInput;
    private bool _isLoading;
    private bool _forceHostedRefresh;
    private bool _isHydratingDeep;
    private string? _error;
    private string? _backgroundError;
    private int _analysisVersion;
    private bool _hasRendered;
    private bool _pendingPersistRecentRun;
    private string? _lastRunKey;
    private CancellationTokenSource? _overviewHydrationCts;
    private DateTimeOffset? _scanStartedAt;
    private DateTimeOffset? _quickReadyAt;
    private DateTimeOffset? _deepReadyAt;
    private List<RecentToolRun> _recentRuns = new();
    private DomainHealthCheck? _healthCheck;
    private DomainDetective.Views.HttpInfo? _httpInfo;
    private DomainDetective.Views.SecurityTxtInfo? _securityTxtInfo;
    private DomainDetective.Views.CertificateInfo? _certificateInfo;
    private DomainDetective.Views.BimiRecordInfo? _bimiInfo;
    private DomainDetective.Views.MtastsInfo? _mtastsInfo;
    private DomainDetective.Views.RdapInfo? _rdapInfo;
    private DomainDetective.Views.DnsPropagationSetInfo? _dnsPropagationInfo;
    private DomainDetective.Views.SubdomainsInfo? _subdomainsInfo;
    private DomainDetective.Views.Microsoft365OverviewInfo? _microsoft365OverviewInfo;
    private DomainDetective.Views.DomainOverviewInfo? _domainOverviewInfo;
    private string? _dnsRequestedTypes;
    private string? _dnsHostLabel;
    private string? _dnsBrowserResolverName;

    protected override void OnInitialized() {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnParametersSetAsync() {
        await Availability.InitializeAsync();
        await SyncWithCurrentUriAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        _hasRendered = true;

        if (firstRender) {
            var recentRuns = await JS.InvokeAsync<List<RecentToolRun>>("domainDetectiveTools.loadRecentRuns", Definition.Slug);
            _recentRuns = recentRuns ?? new List<RecentToolRun>();
            await InvokeAsync(StateHasChanged);
        }

        if (_pendingPersistRecentRun) {
            _pendingPersistRecentRun = false;
            await PersistRecentRunAsync();
        }
    }

    private async Task RunAnalysis() {
        if (string.IsNullOrWhiteSpace(_domain)) return;

        CancelOverviewHydration();
        _isLoading = true;
        _isHydratingDeep = false;
        _error = null;
        _backgroundError = null;
        _scanStartedAt = DateTimeOffset.Now;
        _quickReadyAt = null;
        _deepReadyAt = null;
        _healthCheck = null;
        _httpInfo = null;
        _securityTxtInfo = null;
        _certificateInfo = null;
        _bimiInfo = null;
        _mtastsInfo = null;
        _rdapInfo = null;
        _dnsPropagationInfo = null;
        _subdomainsInfo = null;
        _microsoft365OverviewInfo = null;
        _domainOverviewInfo = null;
        _lastRunKey = BuildRunKey(_domain, _secondaryInput, _dnsHostLabel, _dnsBrowserResolverName);
        UpdateBrowserUrl();
        var analysisVersion = ++_analysisVersion;
        StateHasChanged();

        try {
            var hc = Definition.Slug == "dns-lookup"
                ? DnsService.CreateHealthCheck(_dnsBrowserResolverName)
                : DnsService.CreateHealthCheck();

            switch (Definition.Slug) {
                case "m365-overview":
                    if (Availability.IsHostedOnline) {
                        _microsoft365OverviewInfo = await HostedAnalysisService.AnalyzeMicrosoft365OverviewQuickAsync(_domain, _forceHostedRefresh);
                        _quickReadyAt = DateTimeOffset.Now;
                        _isHydratingDeep = _microsoft365OverviewInfo.IsPartial;
                        if (_isHydratingDeep) {
                            _overviewHydrationCts = new CancellationTokenSource();
                            _ = LoadDeepOverviewAsync("m365-overview", _domain, _forceHostedRefresh, analysisVersion, _overviewHydrationCts.Token);
                        } else {
                            _deepReadyAt = _quickReadyAt;
                        }
                    } else {
                        _microsoft365OverviewInfo = await BrowserOverviewService.AnalyzeMicrosoft365OverviewLiteAsync(_domain);
                        _quickReadyAt = DateTimeOffset.Now;
                        _deepReadyAt = _quickReadyAt;
                    }
                    break;
                case "domain-overview":
                    if (Availability.IsHostedOnline) {
                        _domainOverviewInfo = await HostedAnalysisService.AnalyzeDomainOverviewQuickAsync(_domain, _forceHostedRefresh);
                        _quickReadyAt = DateTimeOffset.Now;
                        _isHydratingDeep = _domainOverviewInfo.IsPartial;
                        if (_isHydratingDeep) {
                            _overviewHydrationCts = new CancellationTokenSource();
                            _ = LoadDeepOverviewAsync("domain-overview", _domain, _forceHostedRefresh, analysisVersion, _overviewHydrationCts.Token);
                        } else {
                            _deepReadyAt = _quickReadyAt;
                        }
                    } else {
                        _domainOverviewInfo = await BrowserOverviewService.AnalyzeDomainOverviewLiteAsync(_domain);
                        _quickReadyAt = DateTimeOffset.Now;
                        _deepReadyAt = _quickReadyAt;
                    }
                    break;
                case "spf": await hc.VerifySPF(_domain); break;
                case "dkim":
                    await hc.VerifyDKIM(_domain, GetDkimSelectors());
                    break;
                case "dmarc": await hc.VerifyDMARC(_domain); break;
                case "mx": await hc.VerifyMX(_domain); break;
                case "mta-sts":
                    if (Availability.IsHostedOnline) {
                        _mtastsInfo = await HostedAnalysisService.AnalyzeMtastsAsync(_domain, _forceHostedRefresh);
                    } else {
                        await hc.VerifyMTASTSBootstrap(_domain);
                    }
                    break;
                case "tls-rpt": await hc.VerifyTLSRPT(_domain); break;
                case "bimi":
                    try {
                        _bimiInfo = await HostedAnalysisService.AnalyzeBimiAsync(_domain, _forceHostedRefresh);
                    } catch (HostedAnalysisUnavailableException) {
                        await hc.VerifyBIMI(_domain, skipIndicatorDownload: true);
                    }
                    break;
                case "dns-lookup": await hc.VerifyDnsInventoryAsync(_domain); break;
                case "dnssec": await hc.VerifyDNSSEC(_domain); break;
                case "soa": await hc.VerifySOA(_domain); break;
                case "ns": await hc.VerifyNS(_domain); break;
                case "dns-propagation":
                    if (Availability.IsHostedOnline) {
                        _dnsPropagationInfo = await HostedAnalysisService.AnalyzeDnsPropagationAsync(_domain, _forceHostedRefresh);
                    } else {
                        await DnsService.AnalyzeDnsPropagationAsync(hc, _domain);
                    }
                    break;
                case "caa": await hc.VerifyCAA(_domain); break;
                case "dane": await hc.VerifyDANE(_domain, new[] { DomainDetective.ServiceType.SMTP, DomainDetective.ServiceType.HTTPS }); break;
                case "cert-check":
                    _certificateInfo = await HostedAnalysisService.AnalyzeCertificateAsync(_domain, _forceHostedRefresh);
                    break;
                case "http-headers":
                    _httpInfo = await HostedAnalysisService.AnalyzeHttpHeadersAsync(_domain, _forceHostedRefresh);
                    break;
                case "security-txt":
                    _securityTxtInfo = await HostedAnalysisService.AnalyzeSecurityTxtAsync(_domain, _forceHostedRefresh);
                    break;
                case "rdap":
                    _rdapInfo = await HostedAnalysisService.AnalyzeRdapAsync(_domain, _forceHostedRefresh);
                    break;
                case "dnsbl": await hc.VerifyDNSBLWithMode(_domain, DomainDetective.DomainIpScanMode.MxAOnly); break;
                case "dangling-cname": await hc.VerifyDanglingCname(_domain); break;
                case "ct-subdomains":
                    _subdomainsInfo = await HostedAnalysisService.AnalyzeCtSubdomainsAsync(_domain, _forceHostedRefresh);
                    break;
            }

            if (_httpInfo == null && _securityTxtInfo == null && _certificateInfo == null && _mtastsInfo == null && _rdapInfo == null && _dnsPropagationInfo == null && _subdomainsInfo == null && _microsoft365OverviewInfo == null && _domainOverviewInfo == null) {
                _healthCheck = hc;
            }

            await QueueRecentRunPersistenceAsync();
        } catch (HostedAnalysisException ex) {
            _error = ex.Message;
        } catch (HttpRequestException ex) {
            _error = ex.Message;
        } catch (TaskCanceledException ex) {
            _error = ex.Message;
        } catch (InvalidOperationException ex) {
            _error = ex.Message;
        } catch (ArgumentException ex) {
            _error = ex.Message;
        } finally {
            _forceHostedRefresh = false;
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadDeepOverviewAsync(string slug, string domainName, bool forceRefresh, int analysisVersion, CancellationToken cancellationToken) {
        try {
            switch (slug) {
                case "m365-overview":
                    var microsoft365Overview = await HostedAnalysisService.AnalyzeMicrosoft365OverviewAsync(domainName, forceRefresh, cancellationToken);
                    if (analysisVersion != _analysisVersion) {
                        return;
                    }

                    _microsoft365OverviewInfo = microsoft365Overview;
                    _deepReadyAt = DateTimeOffset.Now;
                    break;
                case "domain-overview":
                    var domainOverview = await HostedAnalysisService.AnalyzeDomainOverviewAsync(domainName, forceRefresh, cancellationToken);
                    if (analysisVersion != _analysisVersion) {
                        return;
                    }

                    _domainOverviewInfo = domainOverview;
                    _deepReadyAt = DateTimeOffset.Now;
                    break;
            }
        } catch (OperationCanceledException) {
            if (analysisVersion != _analysisVersion) {
                return;
            }
        } catch (HostedAnalysisException ex) {
            if (analysisVersion != _analysisVersion) {
                return;
            }

            _backgroundError = $"The first results loaded, but the full report could not finish: {ex.Message}";
        } catch (HttpRequestException ex) {
            if (analysisVersion != _analysisVersion) {
                return;
            }

            _backgroundError = $"The first results loaded, but the full report could not finish: {ex.Message}";
        } catch (InvalidOperationException ex) {
            if (analysisVersion != _analysisVersion) {
                return;
            }

            _backgroundError = $"The first results loaded, but the full report could not finish: {ex.Message}";
        } finally {
            if (analysisVersion == _analysisVersion) {
                _isHydratingDeep = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CancelOverviewHydration() {
        using var overviewHydrationCts = Interlocked.Exchange(ref _overviewHydrationCts, null);
        if (overviewHydrationCts is null) {
            return;
        }

        try {
            overviewHydrationCts.Cancel();
        } catch (ObjectDisposedException) {
            // Best effort only.
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) {
        _ = InvokeAsync(SyncWithCurrentUriAsync);
    }

    private async Task SyncWithCurrentUriAsync() {
        var query = ParseQuery(new Uri(Navigation.Uri).Query);
        var domain = GetQueryValue(query, "q");
        var secondaryInput = GetQueryValue(query, "s");
        _dnsRequestedTypes = Definition.Slug == "dns-lookup" ? secondaryInput : null;
        _dnsHostLabel = Definition.Slug == "dns-lookup" ? GetQueryValue(query, "h") : null;
        _dnsBrowserResolverName = Definition.Slug == "dns-lookup" ? NormalizeDnsBrowserResolverName(GetQueryValue(query, "r")) : null;
        var runKey = BuildRunKey(domain, secondaryInput, _dnsHostLabel, _dnsBrowserResolverName);

        if (!string.IsNullOrWhiteSpace(domain)) {
            _domain = domain;
            _secondaryInput = secondaryInput;

            if (!string.Equals(_lastRunKey, runKey, StringComparison.OrdinalIgnoreCase) && !_isLoading) {
                _lastRunKey = runKey;
                await RunAnalysis();
            }

            return;
        }

        if (!string.IsNullOrWhiteSpace(_lastRunKey) || !string.IsNullOrWhiteSpace(_domain)) {
            ResetDisplayedRun();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetDisplayedRun() {
        CancelOverviewHydration();
        _lastRunKey = null;
        _domain = string.Empty;
        _secondaryInput = null;
        _isLoading = false;
        _isHydratingDeep = false;
        _forceHostedRefresh = false;
        _error = null;
        _backgroundError = null;
        _scanStartedAt = null;
        _quickReadyAt = null;
        _deepReadyAt = null;
        _healthCheck = null;
        _httpInfo = null;
        _securityTxtInfo = null;
        _certificateInfo = null;
        _bimiInfo = null;
        _mtastsInfo = null;
        _rdapInfo = null;
        _dnsPropagationInfo = null;
        _subdomainsInfo = null;
        _microsoft365OverviewInfo = null;
        _domainOverviewInfo = null;
        _dnsRequestedTypes = null;
        _dnsHostLabel = null;
        _dnsBrowserResolverName = null;
    }

    private async Task RunFreshAnalysis() {
        _forceHostedRefresh = true;
        await RunAnalysis();
    }

    private async Task RunRecentAsync(RecentToolRun item) {
        _domain = item.Domain;
        _secondaryInput = item.SecondaryInput;
        _dnsRequestedTypes = Definition.Slug == "dns-lookup" ? item.SecondaryInput : null;
        _dnsHostLabel = item.DnsHost;
        _dnsBrowserResolverName = NormalizeDnsBrowserResolverName(item.DnsResolver);
        await RunAnalysis();
    }

    private bool CanRunOnline(ToolDefinition definition) {
        return Availability.CanRun(definition);
    }

    private static bool UsesCustomToolLayout(ToolDefinition definition) {
        return definition.Slug == "raw-dns-query";
    }

    private static bool SupportsHostedCache(ToolDefinition definition) {
        return definition.Slug == "m365-overview" || definition.Slug == "domain-overview";
    }

    private static bool IsOverviewTool(ToolDefinition definition) {
        return definition.Slug == "m365-overview" || definition.Slug == "domain-overview";
    }

    private static string? NormalizeDnsBrowserResolverName(string? resolverName) {
        if (string.IsNullOrWhiteSpace(resolverName)) {
            return null;
        }

        return BrowserDnsService.GetResolverProfile(resolverName).Name;
    }

    private static bool SupportsLiteTool(ToolDefinition definition) {
        return IsOverviewTool(definition) || definition.Slug == "dns-propagation" || definition.Slug == "mta-sts";
    }

    private static string GetStaticEditionTitle(ToolDefinition definition) {
        return definition.Slug switch {
            "dns-propagation" => "Web edition propagation sample",
            "mta-sts" => "Web edition MTA-STS check",
            _ => "Web edition overview"
        };
    }

    private static string GetStaticEditionDescription(ToolDefinition definition) {
        return definition.Slug switch {
            "dns-propagation" => "This web edition compares answers across a smaller public resolver sample. Extra resolver coverage is added automatically in the deeper online run.",
            "mta-sts" => "This web edition validates the published MTA-STS DNS bootstrap record. Policy hosting and MX-policy correlation are added automatically in the deeper online run.",
            _ => "This web edition shows the DD sections that run safely in the browser. Deeper sections stay visible below and are marked clearly when they need the broader online run."
        };
    }

    private async Task QueueRecentRunPersistenceAsync() {
        if (_hasRendered) {
            await PersistRecentRunAsync();
            return;
        }

        _pendingPersistRecentRun = true;
    }

    private async Task PersistRecentRunAsync() {
        if (string.IsNullOrWhiteSpace(_domain)) {
            return;
        }

        var item = new RecentToolRun {
            Domain = _domain.Trim(),
            SecondaryInput = string.IsNullOrWhiteSpace(_secondaryInput) ? null : _secondaryInput.Trim(),
            DnsHost = string.IsNullOrWhiteSpace(_dnsHostLabel) ? null : _dnsHostLabel.Trim(),
            DnsResolver = string.IsNullOrWhiteSpace(_dnsBrowserResolverName) ? null : _dnsBrowserResolverName.Trim(),
            SavedAtUtc = DateTimeOffset.UtcNow
        };

        _recentRuns = await JS.InvokeAsync<List<RecentToolRun>>("domainDetectiveTools.saveRecentRun", Definition.Slug, item) ?? new List<RecentToolRun>();
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateBrowserUrl() {
        var url = BuildToolUrl(_domain, _secondaryInput);
        Navigation.NavigateTo(url, replace: true);
    }

    private string BuildPermalinkUrl() {
        return BuildToolUrl(_domain, _secondaryInput);
    }

    private IReadOnlyList<string> GetPendingSections() {
        if (_microsoft365OverviewInfo is not null) {
            return _microsoft365OverviewInfo.PendingSections.Take(4).ToList();
        }

        if (_domainOverviewInfo is not null) {
            return _domainOverviewInfo.PendingSections.Take(4).ToList();
        }

        return Array.Empty<string>();
    }

    private int GetProgressPercentage() {
        if (_isLoading && !IsOverviewTool(Definition)) {
            return 32;
        }

        if (_isLoading && IsOverviewTool(Definition) && _quickReadyAt is null) {
            return 18;
        }

        if (_isHydratingDeep) {
            var totalSections = Definition.Slug switch {
                "m365-overview" => 8,
                "domain-overview" => 7,
                _ => 1
            };
            var pendingCount = GetPendingSections().Count;
            var completed = Math.Max(1, totalSections - pendingCount);
            return Math.Clamp((int)Math.Round((double)completed / totalSections * 100), 40, 96);
        }

        if (_quickReadyAt.HasValue && _deepReadyAt.HasValue) {
            return 100;
        }

        return 0;
    }

    private string GetProgressTitle() {
        if (_isHydratingDeep) {
            return $"Analyzing {_domain}";
        }

        return string.IsNullOrWhiteSpace(_domain) ? "Preparing analysis" : $"Analyzing {_domain}";
    }

    private string GetProgressLabel() {
        if (_isHydratingDeep) {
            return $"Step 2 of 2 · {GetProgressPercentage()}%";
        }

        if (IsOverviewTool(Definition)) {
            return "Step 1 of 2";
        }

        return "Running checks";
    }

    private string GetProgressDescription() {
        if (_isHydratingDeep) {
            var pendingSections = GetPendingSections();
            return pendingSections.Count > 0
                ? $"The first results are ready. DomainDetective is still building the deeper sections for {string.Join(", ", pendingSections)}."
                : "The first results are ready. DomainDetective is finishing the deeper sections.";
        }

        return IsOverviewTool(Definition)
            ? "Running the first report pass and preparing the deeper sections."
            : "Running DomainDetective checks and building the result view.";
    }

    private static string GetProgressStepClass(bool isReady, bool isActive) {
        var className = "tool-progress-step";
        if (isReady) {
            className += " tool-progress-step-ready";
        } else if (isActive) {
            className += " tool-progress-step-active";
        }

        return className;
    }

    private static string? GetQueryValue(Dictionary<string, string> query, string key) {
        if (!query.TryGetValue(key, out var values)) {
            return null;
        }

        var value = values;
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private static string? BuildRunKey(string? domain, string? secondaryInput, string? hostLabel, string? browserResolverName) {
        if (string.IsNullOrWhiteSpace(domain)) {
            return null;
        }

        return $"{domain.Trim().ToLowerInvariant()}::{secondaryInput?.Trim().ToLowerInvariant() ?? string.Empty}::{hostLabel?.Trim().ToLowerInvariant() ?? string.Empty}::{browserResolverName?.Trim().ToLowerInvariant() ?? string.Empty}";
    }

    private string BuildToolUrl(string? domain, string? secondaryInput) {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = ParseQuery(uri.Query);

        if (string.IsNullOrWhiteSpace(domain)) {
            query.Remove("q");
        } else {
            query["q"] = domain.Trim();
        }

        if (string.IsNullOrWhiteSpace(secondaryInput)) {
            query.Remove("s");
        } else {
            query["s"] = secondaryInput.Trim();
        }

        if (Definition.Slug == "dns-lookup") {
            if (string.IsNullOrWhiteSpace(_dnsHostLabel)) {
                query.Remove("h");
            } else {
                query["h"] = _dnsHostLabel.Trim();
            }

            if (string.IsNullOrWhiteSpace(_dnsBrowserResolverName)) {
                query.Remove("r");
            } else {
                query["r"] = _dnsBrowserResolverName.Trim();
            }
        } else {
            query.Remove("h");
            query.Remove("r");
        }

        var queryString = BuildQueryString(query);
        return string.IsNullOrWhiteSpace(queryString)
            ? uri.GetLeftPart(UriPartial.Path)
            : $"{uri.GetLeftPart(UriPartial.Path)}?{queryString}";
    }

    private static Dictionary<string, string> ParseQuery(string? query) {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(query)) {
            return result;
        }

        var trimmed = query[0] == '?' ? query[1..] : query;
        if (trimmed.Length == 0) {
            return result;
        }

        foreach (var pair in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries)) {
            var separatorIndex = pair.IndexOf('=');
            if (separatorIndex < 0) {
                var keyOnly = Uri.UnescapeDataString(pair);
                result[keyOnly] = string.Empty;
                continue;
            }

            var key = Uri.UnescapeDataString(pair[..separatorIndex]);
            var value = Uri.UnescapeDataString(pair[(separatorIndex + 1)..]);
            result[key] = value;
        }

        return result;
    }

    private static string BuildQueryString(Dictionary<string, string> query) {
        return string.Join("&",
            query
                .Where(static item => !string.IsNullOrWhiteSpace(item.Key))
                .Select(static item => $"{Uri.EscapeDataString(item.Key)}={Uri.EscapeDataString(item.Value ?? string.Empty)}"));
    }

    private string[] GetDkimSelectors() {
        if (string.IsNullOrWhiteSpace(_secondaryInput)) {
            return Array.Empty<string>();
        }

        return _secondaryInput
            .Split(new[] { ',', ';', ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(static selector => selector.Trim())
            .Where(static selector => selector.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static string FormatTimestamp(DateTimeOffset? timestamp) {
        return timestamp.HasValue ? timestamp.Value.ToString("HH:mm:ss") : "pending";
    }

    public void Dispose() {
        Navigation.LocationChanged -= HandleLocationChanged;
        CancelOverviewHydration();
    }

