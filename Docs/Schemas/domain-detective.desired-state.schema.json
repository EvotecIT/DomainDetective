        },
        "smtpTls": {
          "$ref": "#/$defs/mailTlsPolicy"
        },
        "imapTls": {
          "$ref": "#/$defs/mailTlsPolicy"
        },
        "pop3Tls": {
          "$ref": "#/$defs/mailTlsPolicy"
        },
        "smtpBanner": {
          "$ref": "#/$defs/smtpBannerPolicy"
        },
        "smtpAuth": {
