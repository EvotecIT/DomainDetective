{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evotec.xyz/schemas/domain-detective.desired-state.schema.json",
  "title": "DomainDetective Desired State Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional schema reference for editor IntelliSense."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Schema version (currently 1)."
    },
    "defaults": {
      "$ref": "#/$defs/profile"
    },
    "overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/override"
      }
    }
  },
  "required": [
    "version",
    "defaults"
  ],
  "$defs": {
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/match"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        }
      },
      "required": [
        "match",
        "profile"
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domainPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Wildcard patterns used to select a profile (e.g., '*.example.com'). Patterns are limited to 512 characters and 128 wildcards; overly complex patterns are ignored."
        },
        "classifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mailClassification"
          },
          "description": "Mail domain classifications that must match for this override to apply."
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/healthCheckType"
          },
          "description": "Health check modules to run as part of this profile."
        },
        "assessmentPolicy": {
          "$ref": "#/$defs/assessmentPolicy"
        },
        "dmarc": {
          "$ref": "#/$defs/dmarcPolicy"
        },
        "spf": {
          "$ref": "#/$defs/spfPolicy"
        },
        "dkim": {
          "$ref": "#/$defs/dkimPolicy"
        },
        "mtasts": {
          "$ref": "#/$defs/mtastsPolicy"
        },
        "tlsrpt": {
