@page "/"
@page "/{ToolSlug}"
@inject ToolRegistry Registry
@inject ToolAvailabilityService Availability
@inject NavigationManager Navigation

@* Mounted into #dd-tool-root on each static tool page. The page itself renders the breadcrumb, title,
   description, code samples and related tools, so this component renders only the interactive tool. *@

@if (!_isReady || string.IsNullOrEmpty(ToolSlug)) {
    @* Nothing to render: the tools hub at /tools/ is a static page and never mounts the WebAssembly app. *@
} else {
    var tool = Registry.GetBySlug(ToolSlug);
    if (tool is null) {
        <div class="tool-not-found">
            <h2>Tool not found</h2>
            <p>No tool matches "<strong>@ToolSlug</strong>". <a href="/tools/">Browse all tools</a></p>
        </div>
    } else if (Availability.IsStaticOnly && tool.HostedCompatible && !tool.BrowserCompatible && !tool.LiteCompatible) {
        <div class="tool-page">
            <HostedFeaturePreview Tool="tool" Domain="@GetToolDomainQuery()" />
        </div>
    } else if (!Availability.CanRun(tool)) {
        <div class="tool-page">
            <ToolNotAvailable Tool="tool" Domain="@GetToolDomainQuery()" />
        </div>
    } else {
        <ToolPage Definition="tool" ShowHeader="false" ShowUsageExamples="false" />
    }
}

@code {
    [Parameter] public string? ToolSlug { get; set; }
    [SupplyParameterFromQuery(Name = "domain")] public string? DomainQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? ToolDomainQuery { get; set; }

    private bool _isReady;

    protected override async Task OnParametersSetAsync() {
        if (string.Equals(ToolSlug, "dns-query-playground", StringComparison.OrdinalIgnoreCase)) {
            var currentUri = new Uri(Navigation.Uri);
            var suffix = $"{currentUri.Query}{currentUri.Fragment}";
            Navigation.NavigateTo($"/tools/raw-dns-query/{suffix}", forceLoad: true, replace: true);
            return;
        }

        if (string.IsNullOrEmpty(ToolSlug) && !string.IsNullOrWhiteSpace(DomainQuery)) {
            var target = "/tools/domain-overview/?q=" + Uri.EscapeDataString(DomainQuery.Trim());
            Navigation.NavigateTo(target, forceLoad: true, replace: true);
            return;
        }

        await Availability.InitializeAsync();
        _isReady = true;
    }

    private string? GetToolDomainQuery() {
        return string.IsNullOrWhiteSpace(ToolDomainQuery) ? null : ToolDomainQuery.Trim();
    }
}
