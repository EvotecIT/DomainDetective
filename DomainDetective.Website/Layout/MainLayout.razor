@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject DomainDetective.Website.Services.SiteNavigationService SiteNavigationService

<div class="dd-app" @onclick="CloseMenus">
    <header class="dd-header">
        <div class="dd-header-inner">
            <a href="/" class="dd-brand">
                <svg class="dd-logo" viewBox="0 0 32 32" width="28" height="28" fill="none">
                    <circle cx="16" cy="16" r="14" stroke="var(--dd-accent)" stroke-width="2" fill="none"/>
                    <path d="M10 16l4 4 8-8" stroke="var(--dd-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
                <span>Domain Detective</span>
            </a>

            <button class="dd-nav-toggle"
                    type="button"
                    aria-label="Toggle navigation"
                    aria-expanded="@(_mobileNavOpen ? "true" : "false")"
                    @onclick:stopPropagation="true"
                    @onclick="ToggleMobileNav">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>

            <nav class="dd-nav @(GetNavClass())" aria-label="Main navigation" @onclick:stopPropagation="true">
                <div class="dd-nav-links">
                    @foreach (var item in PrimaryNavigation) {
                        if (item.Items.Count > 0) {
                            var itemLabel = item.Label;
                            var itemHref = item.Href ?? "/";
                            var isDropdownOpen = IsDropdownOpen(itemHref);
                            var isItemActive = IsItemActive(item);
                            <div class="dd-nav-dropdown @(GetDropdownClass(itemHref, isItemActive))">
                                <button class="dd-nav-dropdown-trigger @(isDropdownOpen || isItemActive ? "is-active" : string.Empty)"
                                        type="button"
                                        aria-expanded="@(isDropdownOpen ? "true" : "false")"
                                        aria-haspopup="true"
                                        @onclick="@(() => ToggleDropdown(itemHref))">
                                    @itemLabel
                                    <svg class="dd-nav-dropdown-arrow" viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path d="M3 5l3 3 3-3" />
                                    </svg>
                                </button>
                                <div class="dd-nav-dropdown-menu">
                                    @foreach (var child in item.Items) {
                                        <a href="@GetHref(child.Href)"
                                           target="@GetTarget(child)"
                                           rel="@GetRel(child)">@child.Label</a>
                                    }
                                </div>
                            </div>
                        } else {
                            <a href="@GetHref(item.Href)"
                               class="@GetNavLinkClass(item)"
                               aria-current="@(IsItemActive(item) ? "page" : null)"
                               target="@GetTarget(item)"
                               rel="@GetRel(item)">@item.Label</a>
                        }
                    }
                </div>

                <div class="dd-nav-actions">
                    @foreach (var action in NavigationActions) {
                        if (string.Equals(action.Kind, "button", StringComparison.OrdinalIgnoreCase)) {
                            <button type="button"
                                    class="@action.CssClass"
                                    title="@action.Title"
                                    aria-label="@GetActionAriaLabel(action)"
                                    @onclick="ToggleThemeAsync">@RenderIcon(action.IconHtml)</button>
                        } else {
                            <a href="@GetHref(action.Href)"
                               class="@action.CssClass"
                               target="@GetTarget(action)"
                               rel="@GetRel(action)"
                               title="@action.Title"
                               aria-label="@GetActionAriaLabel(action)">
                                @RenderIcon(action.IconHtml)@GetActionText(action)
                            </a>
                        }
                    }
                </div>
            </nav>
        </div>
    </header>

    <main class="dd-main">
        <div class="dd-main-inner">
            @Body
        </div>
    </main>

    <footer class="dd-footer">
        <div class="dd-footer-inner">
            <div class="dd-footer-grid">
                <div class="dd-footer-brand">
                    <div class="dd-footer-logo">
                        <svg viewBox="0 0 32 32" width="24" height="24" fill="none">
                            <circle cx="16" cy="16" r="14" stroke="var(--dd-accent)" stroke-width="2" fill="none" />
                            <path d="M10 16l4 4 8-8" stroke="var(--dd-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                        </svg>
                        <span>Domain Detective</span>
                    </div>
                    <p class="dd-footer-tagline">Comprehensive domain analysis toolkit. 115+ protocol checks for DNS, email security, TLS, and web security. Privacy-first online analysis with browser-native checks and deeper validation where available.</p>
                    <div class="dd-footer-social">
                        <a href="https://github.com/EvotecIT/DomainDetective" target="_blank" rel="noopener" aria-label="GitHub" class="dd-footer-social-link">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
                        </a>
                        <a href="https://www.nuget.org/packages/DomainDetective" target="_blank" rel="noopener" aria-label="NuGet" class="dd-footer-social-link">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 0L2.4 5.6v12.8L12 24l9.6-5.6V5.6L12 0zm0 2.1l7.8 4.5v9.1L12 20.2l-7.8-4.5V6.6L12 2.1z" /><circle cx="8" cy="14" r="2.5" /><circle cx="16" cy="10" r="3.5" /><circle cx="6" cy="8" r="1.5" /></svg>
                        </a>
                    </div>
                </div>

                <div class="dd-footer-col">
                    <p class="dd-footer-heading">Tools</p>
                    <ul>
                        @foreach (var link in FooterTools) {
                            <li><a href="@GetHref(link.Href)">@link.Label</a></li>
                        }
                    </ul>
                </div>

                <div class="dd-footer-col">
                    <p class="dd-footer-heading">Resources</p>
                    <ul>
                        @foreach (var link in FooterResources) {
                            <li>
                                <a href="@GetHref(link.Href)" target="@GetTarget(link)" rel="@GetRel(link)">@link.Label</a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="dd-footer-col">
                    <p class="dd-footer-heading">Company</p>
                    <ul>
                        @foreach (var link in FooterCompany) {
                            <li>
                                <a href="@GetHref(link.Href)" target="@GetTarget(link)" rel="@GetRel(link)">@link.Label</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="dd-footer-bottom">
                <p>&copy; @DateTime.UtcNow.Year <a href="https://evotec.xyz" target="_blank" rel="noopener">Evotec Services</a>. Built with <a href="https://github.com/EvotecIT/PSPublishModule" target="_blank" rel="noopener">PowerForge</a>.</p>
                <p class="dd-footer-privacy">Privacy-first online analysis with browser-native checks and deeper validation where available. Analysis results are not stored.</p>
            </div>
        </div>
    </footer>
</div>

@code {
    private static readonly IReadOnlyList<DomainDetective.Website.Models.SiteNavigationItem> FallbackPrimaryNavigation = new[] {
        CreateItem("/", "Home"),
        CreateItem("/tools/", "Tools"),
        CreateItem("/docs/", "Docs"),
        CreateItem("/api/", "API", new[] {
            CreateItem("/api/", "DomainDetective C# API"),
            CreateItem("/api/powershell/", "DomainDetective PowerShell API"),
            CreateItem("/api/dnsclientx/", "DnsClientX C# API"),
            CreateItem("/api/dnsclientx-powershell/", "DnsClientX PowerShell API")
        }),
        CreateItem("/blog/", "Blog"),
        CreateItem("/downloads/", "Downloads")
    };

    private static readonly IReadOnlyList<DomainDetective.Website.Models.SiteNavigationItem> FallbackFooterTools = new[] {
        CreateItem("/tools/spf/", "SPF Lookup"),
        CreateItem("/tools/dkim/", "DKIM Lookup"),
        CreateItem("/tools/dmarc/", "DMARC Lookup"),
        CreateItem("/tools/dns-lookup/", "DNS Lookup"),
        CreateItem("/tools/dnsbl/", "DNSBL Check"),
        CreateItem("/tools/", "All Tools")
    };

    private static readonly IReadOnlyList<DomainDetective.Website.Models.SiteNavigationItem> FallbackFooterResources = new[] {
        CreateItem("/docs/quickstart/", "Quick Start"),
        CreateItem("/api/", "C# API Reference"),
        CreateItem("/api/powershell/", "PowerShell API Reference"),
        CreateItem("/tools/raw-dns-query/", "Raw DNS Query"),
        CreateItem("/docs/dnsclientx/", "DnsClientX Docs"),
        CreateItem("/docs/cli-usage/", "CLI Usage"),
        CreateItem("/faq/", "FAQ"),
        CreateItem("https://github.com/EvotecIT/DomainDetective", "GitHub Repository", external: true)
    };

    private static readonly IReadOnlyList<DomainDetective.Website.Models.SiteNavigationItem> FallbackFooterCompany = new[] {
        CreateItem("https://evotec.xyz", "Evotec Services", external: true),
        CreateItem("/blog/", "Blog"),
        CreateItem("/privacy/", "Privacy Policy"),
        CreateItem("/changelog/", "Changelog")
    };

    private static readonly IReadOnlyList<DomainDetective.Website.Models.SiteNavigationAction> FallbackNavigationActions = new[] {
        new DomainDetective.Website.Models.SiteNavigationAction {
            Title = "Toggle theme",
            AriaLabel = "Toggle theme",
            Kind = "button",
            CssClass = "nav-icon theme-cycle-btn",
            IconHtml = "<svg viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true' focusable='false'><circle cx='12' cy='12' r='5'/><path d='M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42'/></svg>"
        },
        new DomainDetective.Website.Models.SiteNavigationAction {
            Title = "DomainDetective on GitHub",
            AriaLabel = "DomainDetective on GitHub",
            Href = "https://github.com/EvotecIT/DomainDetective",
            External = true,
            CssClass = "nav-icon",
            IconHtml = "<svg viewBox='0 0 24 24' fill='currentColor' aria-hidden='true' focusable='false'><path d='M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z'/></svg>"
        },
        new DomainDetective.Website.Models.SiteNavigationAction {
            Title = "Try Online",
            AriaLabel = "Try Domain Detective Online",
            Href = "/tools/",
            CssClass = "nav-cta",
            IconHtml = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' class='nav-cta-icon' aria-hidden='true' focusable='false'><circle cx='11' cy='11' r='8'/><path d='m21 21-4.35-4.35'/></svg>",
            Text = "Try Online"
        }
    };

    private IReadOnlyList<DomainDetective.Website.Models.SiteNavigationItem> PrimaryNavigation { get; set; } = FallbackPrimaryNavigation;
    private IReadOnlyList<DomainDetective.Website.Models.SiteNavigationItem> FooterTools { get; set; } = FallbackFooterTools;
    private IReadOnlyList<DomainDetective.Website.Models.SiteNavigationItem> FooterResources { get; set; } = FallbackFooterResources;
    private IReadOnlyList<DomainDetective.Website.Models.SiteNavigationItem> FooterCompany { get; set; } = FallbackFooterCompany;
    private IReadOnlyList<DomainDetective.Website.Models.SiteNavigationAction> NavigationActions { get; set; } = FallbackNavigationActions;

    private string? _openDropdownHref;
    private bool _mobileNavOpen;

    protected override async Task OnInitializedAsync() {
        var navigation = await SiteNavigationService.GetNavigationAsync();
        if (navigation == null) {
            return;
        }

        if (navigation.Primary.Count > 0) {
            PrimaryNavigation = navigation.Primary;
        }

        FooterTools = GetMenuOrFallback(navigation, "footer-tools", FallbackFooterTools);
        FooterResources = GetMenuOrFallback(navigation, "footer-resources", FallbackFooterResources);
        FooterCompany = GetMenuOrFallback(navigation, "footer-company", FallbackFooterCompany);

        if (navigation.Actions.Count > 0) {
            NavigationActions = navigation.Actions;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            await JS.InvokeVoidAsync("domainDetectiveTools.initTheme");
        }
    }

    private void ToggleDropdown(string href) {
        _openDropdownHref = string.Equals(_openDropdownHref, href, StringComparison.OrdinalIgnoreCase) ? null : href;
    }

    private void ToggleMobileNav() {
        _mobileNavOpen = !_mobileNavOpen;
        if (!_mobileNavOpen) {
            _openDropdownHref = null;
        }
    }

    private void CloseMenus() {
        _openDropdownHref = null;
        _mobileNavOpen = false;
    }

    private async Task ToggleThemeAsync() {
        await JS.InvokeVoidAsync("domainDetectiveTools.toggleTheme");
    }

    private string GetNavClass() {
        return _mobileNavOpen ? "open" : string.Empty;
    }

    private string GetDropdownClass(string href, bool isItemActive) {
        return IsDropdownOpen(href) || isItemActive ? "open" : string.Empty;
    }

    private string GetNavLinkClass(DomainDetective.Website.Models.SiteNavigationItem item) {
        return IsItemActive(item) ? "dd-nav-link is-active" : "dd-nav-link";
    }

    private bool IsDropdownOpen(string href) {
        return string.Equals(_openDropdownHref, href, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsItemActive(DomainDetective.Website.Models.SiteNavigationItem item) {
        if (!string.IsNullOrWhiteSpace(item.Href) && IsActivePath(item.Href)) {
            return true;
        }

        foreach (var child in item.Items) {
            if (!string.IsNullOrWhiteSpace(child.Href) && IsActivePath(child.Href)) {
                return true;
            }
        }

        return false;
    }

    private bool IsActivePath(string href) {
        var currentPath = NormalizePath(new Uri(Navigation.Uri).AbsolutePath);
        var targetPath = NormalizePath(href);
        if (targetPath == "/") {
            return currentPath == "/";
        }

        return currentPath == targetPath || currentPath.StartsWith(targetPath, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePath(string path) {
        if (string.IsNullOrWhiteSpace(path)) {
            return "/";
        }

        var normalized = path.Replace('\\', '/').Trim();
        if (!normalized.StartsWith("/", StringComparison.Ordinal)) {
            normalized = "/" + normalized;
        }

        return normalized.EndsWith("/", StringComparison.Ordinal) ? normalized : normalized + "/";
    }

    private static IReadOnlyList<DomainDetective.Website.Models.SiteNavigationItem> GetMenuOrFallback(DomainDetective.Website.Models.SiteNavigationData navigation, string menuName, IReadOnlyList<DomainDetective.Website.Models.SiteNavigationItem> fallback) {
        return navigation.Menus.TryGetValue(menuName, out var menuItems) && menuItems.Count > 0 ? menuItems : fallback;
    }

    private static DomainDetective.Website.Models.SiteNavigationItem CreateItem(string href, string text, IEnumerable<DomainDetective.Website.Models.SiteNavigationItem>? items = null, bool external = false) {
        return new DomainDetective.Website.Models.SiteNavigationItem {
            Href = href,
            Text = text,
            Title = text,
            External = external,
            Items = items?.ToList() ?? new List<DomainDetective.Website.Models.SiteNavigationItem>()
        };
    }

    private static string GetHref(string? href) => string.IsNullOrWhiteSpace(href) ? "/" : href;

    private static MarkupString RenderIcon(string? iconHtml) {
        return new MarkupString(iconHtml ?? string.Empty);
    }

    private static string? GetActionText(DomainDetective.Website.Models.SiteNavigationAction action) {
        if (!string.IsNullOrWhiteSpace(action.CssClass) && action.CssClass.Contains("nav-icon", StringComparison.OrdinalIgnoreCase)) {
            return null;
        }

        var text = string.IsNullOrWhiteSpace(action.Text) ? action.Title : action.Text;
        return string.IsNullOrWhiteSpace(text) ? null : $" {text}";
    }

    private static string? GetActionAriaLabel(DomainDetective.Website.Models.SiteNavigationAction action) {
        return string.IsNullOrWhiteSpace(action.AriaLabel) ? action.Title : action.AriaLabel;
    }

    private static string? GetRel(DomainDetective.Website.Models.SiteNavigationItem item) {
        if (!string.IsNullOrWhiteSpace(item.Rel)) {
            return item.Rel;
        }

        return item.External ? "noopener" : null;
    }

    private static string? GetTarget(DomainDetective.Website.Models.SiteNavigationItem item) {
        if (!string.IsNullOrWhiteSpace(item.Target)) {
            return item.Target;
        }

        return item.External ? "_blank" : null;
    }

    private static string? GetRel(DomainDetective.Website.Models.SiteNavigationAction action) {
        if (!string.IsNullOrWhiteSpace(action.Rel)) {
            return action.Rel;
        }

        return action.External ? "noopener" : null;
    }

    private static string? GetTarget(DomainDetective.Website.Models.SiteNavigationAction action) {
        if (!string.IsNullOrWhiteSpace(action.Target)) {
            return action.Target;
        }

        return action.External ? "_blank" : null;
    }
}
