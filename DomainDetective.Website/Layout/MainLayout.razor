@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="dd-app" @onclick="CloseMenus">
    <header class="dd-header">
        <div class="dd-header-inner">
            <a href="/" class="dd-brand">
                <svg class="dd-logo" viewBox="0 0 32 32" width="28" height="28" fill="none">
                    <circle cx="16" cy="16" r="14" stroke="var(--dd-accent)" stroke-width="2" fill="none"/>
                    <path d="M10 16l4 4 8-8" stroke="var(--dd-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
                <span>Domain Detective</span>
            </a>

            <button class="dd-nav-toggle"
                    type="button"
                    aria-label="Toggle navigation"
                    aria-expanded="@(_mobileNavOpen ? "true" : "false")"
                    @onclick:stopPropagation="true"
                    @onclick="ToggleMobileNav">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                    <path d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>

            <nav class="dd-nav @(GetNavClass())" aria-label="Main navigation" @onclick:stopPropagation="true">
                <div class="dd-nav-links">
                    <a href="/" class="@GetNavLinkClass("/")" aria-current="@(IsActivePath("/") ? "page" : null)">Home</a>
                    <a href="/tools/" class="@GetNavLinkClass("/tools/")" aria-current="@(IsActivePath("/tools/") ? "page" : null)">Tools</a>
                    <a href="/docs/" class="@GetNavLinkClass("/docs/")" aria-current="@(IsActivePath("/docs/") ? "page" : null)">Docs</a>
                    <div class="dd-nav-dropdown @GetApiMenuClass()">
                        <button class="dd-nav-dropdown-trigger @(_apiMenuOpen ? "is-active" : string.Empty)"
                                type="button"
                                aria-expanded="@(_apiMenuOpen ? "true" : "false")"
                                aria-haspopup="true"
                                @onclick="ToggleApiMenu">
                            API
                            <svg class="dd-nav-dropdown-arrow" viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M3 5l3 3 3-3" />
                            </svg>
                        </button>
                        <div class="dd-nav-dropdown-menu">
                            <a href="/api/">C# API Reference</a>
                            <a href="/api/powershell/">PowerShell API Reference</a>
                        </div>
                    </div>
                    <a href="/blog/" class="@GetNavLinkClass("/blog/")" aria-current="@(IsActivePath("/blog/") ? "page" : null)">Blog</a>
                    <a href="/downloads/" class="@GetNavLinkClass("/downloads/")" aria-current="@(IsActivePath("/downloads/") ? "page" : null)">Downloads</a>
                </div>

                <div class="dd-nav-actions">
                    <button type="button" class="nav-icon theme-cycle-btn" title="Toggle theme" aria-label="Toggle theme" @onclick="ToggleThemeAsync">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                            <circle cx="12" cy="12" r="5" />
                            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
                        </svg>
                    </button>
                    <a href="https://github.com/EvotecIT/DomainDetective" target="_blank" rel="noopener" class="nav-icon" aria-label="DomainDetective on GitHub">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
                    </a>
                    <a href="/tools/" class="nav-cta" title="Try Online" aria-label="Try Domain Detective Online">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-cta-icon" aria-hidden="true" focusable="false">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.35-4.35" />
                        </svg>
                        Try Online
                    </a>
                </div>
            </nav>
        </div>
    </header>

    <main class="dd-main">
        <div class="dd-main-inner">
            @Body
        </div>
    </main>

    <footer class="dd-footer">
        <div class="dd-footer-inner">
            <div class="dd-footer-grid">
                <div class="dd-footer-brand">
                    <div class="dd-footer-logo">
                        <svg viewBox="0 0 32 32" width="24" height="24" fill="none">
                            <circle cx="16" cy="16" r="14" stroke="var(--dd-accent)" stroke-width="2" fill="none" />
                            <path d="M10 16l4 4 8-8" stroke="var(--dd-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                        </svg>
                        <span>Domain Detective</span>
                    </div>
                    <p class="dd-footer-tagline">Comprehensive domain analysis toolkit. 115+ protocol checks for DNS, email security, TLS, and web security. Privacy-first: browser-native where feasible, hosted when DD needs deeper networking or distributed resolver coverage.</p>
                    <div class="dd-footer-social">
                        <a href="https://github.com/EvotecIT/DomainDetective" target="_blank" rel="noopener" aria-label="GitHub" class="dd-footer-social-link">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
                        </a>
                        <a href="https://www.nuget.org/packages/DomainDetective" target="_blank" rel="noopener" aria-label="NuGet" class="dd-footer-social-link">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 0L2.4 5.6v12.8L12 24l9.6-5.6V5.6L12 0zm0 2.1l7.8 4.5v9.1L12 20.2l-7.8-4.5V6.6L12 2.1z" /><circle cx="8" cy="14" r="2.5" /><circle cx="16" cy="10" r="3.5" /><circle cx="6" cy="8" r="1.5" /></svg>
                        </a>
                    </div>
                </div>

                <div class="dd-footer-col">
                    <p class="dd-footer-heading">Tools</p>
                    <ul>
                        @foreach (var link in FooterTools) {
                            <li><a href="@link.Url">@link.Title</a></li>
                        }
                    </ul>
                </div>

                <div class="dd-footer-col">
                    <p class="dd-footer-heading">Resources</p>
                    <ul>
                        @foreach (var link in FooterResources) {
                            <li>
                                <a href="@link.Url" target="@GetTarget(link)" rel="@GetRel(link)">@link.Title</a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="dd-footer-col">
                    <p class="dd-footer-heading">Company</p>
                    <ul>
                        @foreach (var link in FooterCompany) {
                            <li>
                                <a href="@link.Url" target="@GetTarget(link)" rel="@GetRel(link)">@link.Title</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="dd-footer-bottom">
                <p>&copy; @DateTime.UtcNow.Year <a href="https://evotec.xyz" target="_blank" rel="noopener">Evotec Services</a>. Built with <a href="https://github.com/EvotecIT/PSPublishModule" target="_blank" rel="noopener">PowerForge</a>.</p>
                <p class="dd-footer-privacy">Privacy-first online analysis — browser-native where feasible, hosted when DD needs deeper networking or distributed resolver coverage, with no analysis results stored.</p>
            </div>
        </div>
    </footer>
</div>

@code {
    private static readonly FooterLink[] FooterTools = new[] {
        new FooterLink("SPF Lookup", "/tools/spf/"),
        new FooterLink("DKIM Lookup", "/tools/dkim/"),
        new FooterLink("DMARC Lookup", "/tools/dmarc/"),
        new FooterLink("DNS Lookup", "/tools/dns-lookup/"),
        new FooterLink("DNSBL Check", "/tools/dnsbl/"),
        new FooterLink("All Tools", "/tools/")
    };

    private static readonly FooterLink[] FooterResources = new[] {
        new FooterLink("Quick Start", "/docs/quickstart/"),
        new FooterLink("C# API Reference", "/api/"),
        new FooterLink("PowerShell API Reference", "/api/powershell/"),
        new FooterLink("CLI Usage", "/docs/cli-usage/"),
        new FooterLink("FAQ", "/faq/"),
        new FooterLink("GitHub Repository", "https://github.com/EvotecIT/DomainDetective", true)
    };

    private static readonly FooterLink[] FooterCompany = new[] {
        new FooterLink("Evotec Services", "https://evotec.xyz", true),
        new FooterLink("Blog", "/blog/"),
        new FooterLink("Privacy Policy", "/privacy/"),
        new FooterLink("Changelog", "/changelog/")
    };

    private bool _apiMenuOpen;
    private bool _mobileNavOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            await JS.InvokeVoidAsync("domainDetectiveTools.initTheme");
        }
    }

    private void ToggleApiMenu() {
        _apiMenuOpen = !_apiMenuOpen;
    }

    private void ToggleMobileNav() {
        _mobileNavOpen = !_mobileNavOpen;
        if (!_mobileNavOpen) {
            _apiMenuOpen = false;
        }
    }

    private void CloseMenus() {
        _apiMenuOpen = false;
        _mobileNavOpen = false;
    }

    private async Task ToggleThemeAsync() {
        await JS.InvokeVoidAsync("domainDetectiveTools.toggleTheme");
    }

    private string GetApiMenuClass() {
        return _apiMenuOpen ? "open" : string.Empty;
    }

    private string GetNavClass() {
        return _mobileNavOpen ? "open" : string.Empty;
    }

    private string GetNavLinkClass(string href) {
        return IsActivePath(href) ? "dd-nav-link is-active" : "dd-nav-link";
    }

    private bool IsActivePath(string href) {
        var currentPath = NormalizePath(new Uri(Navigation.Uri).AbsolutePath);
        var targetPath = NormalizePath(href);
        if (targetPath == "/") {
            return currentPath == "/";
        }

        return currentPath == targetPath || currentPath.StartsWith(targetPath, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePath(string path) {
        if (string.IsNullOrWhiteSpace(path)) {
            return "/";
        }

        var normalized = path.Replace('\\', '/').Trim();
        if (!normalized.StartsWith("/", StringComparison.Ordinal)) {
            normalized = "/" + normalized;
        }

        return normalized.EndsWith("/", StringComparison.Ordinal) ? normalized : normalized + "/";
    }

    private static string? GetRel(FooterLink link) => link.External ? "noopener" : null;

    private static string? GetTarget(FooterLink link) => link.External ? "_blank" : null;

    private sealed record FooterLink(string Title, string Url, bool External = false);
}
