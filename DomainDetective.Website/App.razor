@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="@typeof(App).Assembly"
        AdditionalAssemblies="new[] { typeof(DomainDetective.Toolbox.Services.ToolRegistry).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.ToolShellLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.ToolShellLayout)">
            <div class="tool-not-found">
                <h2>Tool not found</h2>
                <p>This address does not match a DomainDetective tool. <a href="/tools/">Browse all tools</a></p>
            </div>
        </LayoutView>
    </NotFound>
</Router>
