<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <!-- Trimming currently breaks the sample under net10.0; keep publish deterministic until the sample is trim-safe again. -->
        <PublishTrimmed>false</PublishTrimmed>
    </PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Spectre.Console" Version="0.55.2" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DomainDetective\DomainDetective.csproj" />
    <ProjectReference Include="..\DomainDetective.Visual\DomainDetective.Visual.csproj" />
    <ProjectReference Include="..\DomainDetective.Pgp\DomainDetective.Pgp.csproj" />
    <ProjectReference Include="..\DomainDetective.Reports\DomainDetective.Reports.csproj" />
    <ProjectReference Include="..\DomainDetective.Reports.Html\DomainDetective.Reports.Html.csproj" />
    <ProjectReference Include="..\DomainDetective.Reports.Office\DomainDetective.Reports.Office.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Data\DNS\PublicDNS.json">
      <Link>Data/DNS/PublicDNS.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
