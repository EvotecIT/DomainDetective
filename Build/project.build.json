    {
      "Project": "DomainDetective",
      "Path": "DomainDetective.CLI/DomainDetective.CLI.csproj",
      "Pattern": "(?m)^[ \\t]*<VersionPrefix>[^<]+</VersionPrefix>",
      "Replacement": "    <VersionPrefix>{Version}</VersionPrefix>"
    },
    {
      "Project": "DomainDetective",
      "Path": "Module/DomainDetective.psd1",
      "Pattern": "(?m)^[ \\t]*ModuleVersion[ \\t]*=[ \\t]*'[^']+'",
      "Replacement": "    ModuleVersion        = '{Version}'"
    }
  ]
